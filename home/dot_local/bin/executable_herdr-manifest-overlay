#!/bin/sh
# herdr のエージェントの判定表（agent detection manifest）に、手元の規則を足した上書きを作る。
#
# herdr の上書き（~/.config/herdr/agent-detection/<agent>.toml）は表を丸ごと置き換えるので、
# 手で書くと herdr が取ってくる新しい表（Claude Code の画面の変化への追随）を受け取れなくなる。
# そこで、herdr が取ってきた最新の表（remote のキャッシュ）の末尾に
# ~/.config/herdr/agent-overlays/<agent>.toml の規則を足して上書きを作る。
#
# - 元の表か足す規則が変わったときだけ作り直し、herdr に読み直させる（上書きの先頭の印で見分ける）。
# - 呼ぶのは systemd の herdr-manifest-overlay.path（元の表の変化で呼ぶ）と chezmoi apply。
# - 足す規則を消すと、この印のある上書きも消す（元の表に戻る）。
# - 元の表がまだ無いときは何もしない（足す規則だけの上書きは、ほかの規則を消してしまう）。
set -eu
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

remote="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/agent-detection/remote"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
overlays="$conf/agent-overlays"
out_dir="$conf/agent-detection"
marker="# generated by herdr-manifest-overlay:"
changed=""

for overlay in "$overlays"/*.toml; do
  [ -f "$overlay" ] || continue
  agent="$(basename "$overlay" .toml)"
  base="$remote/$agent.toml"
  out="$out_dir/$agent.toml"
  if [ ! -f "$base" ]; then
    echo "warning: 元の表が無いので $agent の上書きを作らない: $base" >&2
    continue
  fi
  if [ -f "$out" ] && ! head -n 1 "$out" | grep -q "^$marker"; then
    echo "warning: 手で置いた上書きがあるので $agent は触らない: $out" >&2
    continue
  fi
  stamp="$(cat "$base" "$overlay" | sha256sum | cut -c1-16)"
  if [ -f "$out" ] && head -n 1 "$out" | grep -qx "$marker $stamp"; then
    continue
  fi
  mkdir -p "$out_dir"
  tmp="$(mktemp "$out_dir/.$agent.toml.XXXXXX")"
  {
    echo "$marker $stamp"
    echo "# 生成物なので直接書き換えない。元の表: $base 足す規則: $overlay"
    cat "$base"
    printf '\n'
    cat "$overlay"
  } >"$tmp"
  mv "$tmp" "$out"
  echo "==> herdr の判定表の上書きを作った: $out（元の表 $(sed -n 's/^version = "\(.*\)"$/\1/p' "$base" | head -n 1)）"
  changed="$changed $agent"
done

# 足す規則が無くなった上書き（この印のあるもの）を消す
for out in "$out_dir"/*.toml; do
  [ -f "$out" ] || continue
  agent="$(basename "$out" .toml)"
  [ -f "$overlays/$agent.toml" ] && continue
  head -n 1 "$out" | grep -q "^$marker" || continue
  rm -f "$out"
  echo "==> 足す規則が無いので上書きを消した: $out"
  changed="$changed $agent"
done

[ -n "$changed" ] || exit 0
command -v herdr >/dev/null 2>&1 || exit 0
# サーバが動いていなければ、次の起動で読まれる
herdr server reload-agent-manifests >/dev/null 2>&1 || exit 0

# 上書きが不正だと herdr は警告して元の表に戻るので、効いているかを確かめる
status=0
for agent in $changed; do
  [ -f "$out_dir/$agent.toml" ] || continue
  if ! herdr server agent-manifests --json 2>/dev/null |
    python3 -c 'import json,sys
agent = sys.argv[1]
ms = json.load(sys.stdin)["result"]["manifests"]
sys.exit(0 if any(m.get("agent") == agent and m.get("source_kind") == "local override" for m in ms) else 1)' "$agent"; then
    echo "warning: $agent の上書きが効いていない（不正な表として無視された可能性）。herdr agent explain で確かめる" >&2
    status=1
  fi
done
exit "$status"
