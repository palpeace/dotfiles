#!/usr/bin/env bash
set -euo pipefail

self_gitconfig_path="$HOME/.gitconfig.local"

if [ -e "$self_gitconfig_path" ]; then
    echo "⏭️  $self_gitconfig_path は既に存在するためスキップします。"
    exit 0
fi

echo "🛠️  Git Identity (~/.gitconfig.local) の初期設定を開始します..."

strip_escape_sequences() {
    sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\x1b\][^\x1b]*\x1b\\//g; s/\x1b\].*\x07//g'
}

prompt_value() {
    local prompt="$1"
    local default_val="$2"
    local is_email="${3:-0}"
    local value=""

    if [ -n "${GIT_AUTHOR_NAME:-}" ] && [ "$prompt" = "Git user.name" ]; then
        echo "$GIT_AUTHOR_NAME"
        return
    fi

    if [ -n "${GIT_AUTHOR_EMAIL:-}" ] && [ "$prompt" = "Git user.email" ]; then
        echo "$GIT_AUTHOR_EMAIL"
        return
    fi

    # 端末が無く、NONINTERACTIVE設定時かリダイレクトされている場合のフォールバック
    local can_use_tty=0
    if [ -t 0 ]; then
        can_use_tty=1
    elif [ -c /dev/tty ] && true < /dev/tty 2>/dev/null; then
        can_use_tty=1
    fi

    if [ "$can_use_tty" = "0" ] || [ "${NONINTERACTIVE:-0}" = "1" ]; then
        if [ -n "$default_val" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
            echo "$default_val"
        elif [ "$is_email" = "1" ]; then
            # 表示名もログイン名も slug 化できなかった場合に限りここへ来る。
            # "Developer" のような非アドレスを書くと @ チェックを経ずに
            # ~/.gitconfig.local へ焼き付き、run_once なので二度と直らない。
            # 空を返して呼び出し側の「未決定なので作成をスキップ」経路に落とす。
            echo ""
        else
            echo "Developer"
        fi
        return
    fi

    local tty_fd=""
    if [ -t 0 ]; then
        tty_fd="" # Read directly from stdin
    else
        tty_fd="/dev/tty"
    fi

    while [ -z "$value" ]; do
        if [ -n "${default_val:-}" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
            printf "%s [%s]: " "$prompt" "$default_val" >&2
        else
            printf "%s (必須): " "$prompt" >&2
        fi

        if [ -n "$tty_fd" ]; then
            if ! IFS= read -r value < "$tty_fd"; then
                echo -e "\n⚠️  EOF reached while reading input." >&2
                break
            fi
        else
            if ! IFS= read -r value; then
                echo -e "\n⚠️  EOF reached while reading input." >&2
                break
            fi
        fi

        value="$(printf "%s" "$value" | strip_escape_sequences)"

        if [ -z "$value" ]; then
            if [ -n "${default_val:-}" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
                value="$default_val"
            else
                echo "⚠️  空入力は受け付けていません。もう一度入力してください。" >&2
            fi
        elif [ "$is_email" = "1" ] && [[ "$value" != *@* ]]; then
            echo "⚠️  有効なメールアドレス形式ではありません (@ が必要です)。もう一度入力してください。" >&2
            value=""
        fi
    done

    printf "%s" "$value"
}

# Determine default user name without hardcoding personal identifiers
default_user="${USER:-}"
if [ "$default_user" = "root" ] || [ "$default_user" = "nobody" ]; then
    default_user=""
fi

echo ""
echo "👉 [1/2] 表示名を設定します"
name="$(prompt_value "Git user.name" "${default_user:-Your Name}" 0)"

# 表示名をそのままローカルパートに使うと "Takumi Murai@..." のような不正アドレスに
# なる (しかも下の @ チェックは通過してしまう)。英数字以外を - に畳んで slug 化する。
# なお GitHub の正式な noreply は "<ID>+<username>@users.noreply.github.com" で、
# ID の無い形式は 2017-07 以前に作られたアカウントでしか受理されない。ここで作るのは
# あくまで「そのまま Enter を押されたときに壊れないための下書き」であり、
# push が弾かれる場合は GitHub の Settings > Emails に表示される正式な値を使うこと。
slugify_local_part() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-*//' -e 's/-*$//'
}

default_email=""
if [ -n "$name" ] && [ "$name" != "Your Name" ]; then
    name_slug="$(slugify_local_part "$name")"
    # 日本語氏名など非ASCIIのみの表示名では slug が空になる。ローカルパートに
    # そのまま使える保証があるのはログイン名の方なので、そちらへ落とす。
    [ -z "$name_slug" ] && name_slug="$(slugify_local_part "${default_user:-}")"
    [ -n "$name_slug" ] && default_email="${name_slug}@users.noreply.github.com"
fi

echo ""
echo "👉 [2/2] メールアドレスを設定します"
email="$(prompt_value "Git user.email" "${default_email:-your-email@example.com}" 1)"

echo ""

if [ -z "$name" ] || [ -z "$email" ]; then
    echo "⚠️  Git user.name または user.email が未決定のため $self_gitconfig_path の自動作成をスキップしました。"
    echo "💡 必要に応じて 'git config --global user.name ...' 等を設定してください。"
    exit 0
fi

# ヒアドキュメントへの注入は改行を落とせば成立しない (EOF 行を作れない) ため、
# 防御は tr -d '\n\r' だけで足りる。
# かつて sed 's/EOF//g' も併用していたが、防御に寄与せず正常な入力だけを壊した
# (例: 大文字表記の名前 "GEOFFREY" が "GFREY" になる)。復活させないこと。
clean_name="$(printf "%s" "$name" | tr -d '\n\r')"
clean_email="$(printf "%s" "$email" | tr -d '\n\r')"

cat >"$self_gitconfig_path" <<EOF
[user]
    name = $clean_name
    email = $clean_email
EOF

echo "✅ $self_gitconfig_path を作成しました ($name <$email>)。"

mkdir -p "$HOME/repos"
echo "📁 作業ディレクトリを作成しました (~/repos)。"
