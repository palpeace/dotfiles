#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(chezmoi source-path)/.."
source_settings_file="${repo_dir}/assets/orca/settings.json"
source_keymap_file="${repo_dir}/assets/orca/keymap.json"
source_wslconfig_file="${repo_dir}/assets/wslconfig/.wslconfig"

windows_user="${WINDOWS_USER:-$USER}"
windows_home="/mnt/c/Users/${windows_user}"

target_dir="${windows_home}/AppData/Roaming/Orca"
target_wslconfig="${windows_home}/.wslconfig"

if [ ! -d "$windows_home" ]; then
    echo "Windows home not found: $windows_home" >&2
    echo "Set WINDOWS_USER if your Windows username differs from your WSL username." >&2
    exit 1
fi

if [ ! -f "$source_settings_file" ] || [ ! -f "$source_keymap_file" ]; then
    echo "Orca settings source not found under ${repo_dir}/assets/orca" >&2
    exit 1
fi

# 1. Orca Settings & Keymaps 適用
mkdir -p "$target_dir"

if [ -f "${target_dir}/settings.json" ]; then
    backup_file="${target_dir}/settings.json.bak.$(date +%Y%m%d%H%M%S)"
    cp "${target_dir}/settings.json" "$backup_file"
    echo "Backed up existing Orca settings to $backup_file"
fi

if [ -f "${target_dir}/keymap.json" ]; then
    backup_file="${target_dir}/keymap.json.bak.$(date +%Y%m%d%H%M%S)"
    cp "${target_dir}/keymap.json" "$backup_file"
    echo "Backed up existing Orca keymap to $backup_file"
fi

cp "$source_settings_file" "${target_dir}/settings.json"
cp "$source_keymap_file" "${target_dir}/keymap.json"

echo "✅ Applied Orca settings to ${target_dir}/settings.json"
echo "✅ Applied Orca keymap to ${target_dir}/keymap.json"

# 2. WSL2 オートスケール & リソース自動最適化設定 (.wslconfig) 適用
if [ -f "$source_wslconfig_file" ]; then
    if [ -f "$target_wslconfig" ]; then
        cp "$target_wslconfig" "${target_wslconfig}.bak.$(date +%Y%m%d%H%M%S)"
    fi
    cp "$source_wslconfig_file" "$target_wslconfig"
    echo "⚡ Applied WSL2 Auto-Scaling & Resource config to $target_wslconfig"
fi
