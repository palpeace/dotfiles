#!/usr/bin/env bash
set -euo pipefail

self_gitconfig_path="$HOME/.gitconfig.local"

if [ -e "$self_gitconfig_path" ]; then
    echo "⏭️  $self_gitconfig_path は既に存在するためスキップします。"
    exit 0
fi

echo "🛠️  Git Identity (~/.gitconfig.local) の初期設定を開始します..."

strip_escape_sequences() {
    sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\x1b\][^\x1b]*\x1b\\//g; s/\x1b\].*\x07//g'
}

prompt_value() {
    local prompt="$1"
    local default_val="$2"
    local value=""

    if [ -n "${GIT_AUTHOR_NAME:-}" ] && [ "$prompt" = "Git user.name" ]; then
        echo "$GIT_AUTHOR_NAME"
        return
    fi

    if [ -n "${GIT_AUTHOR_EMAIL:-}" ] && [ "$prompt" = "Git user.email" ]; then
        echo "$GIT_AUTHOR_EMAIL"
        return
    fi

    if [ ! -t 0 ] || [ "${NONINTERACTIVE:-0}" = "1" ]; then
        if [ -n "$default_val" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
            echo "$default_val"
        else
            echo ""
        fi
        return
    fi

    while [ -z "$value" ]; do
        if [ -n "${default_val:-}" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
            printf "%s [%s]: " "$prompt" "$default_val" >&2
        else
            printf "%s (必須): " "$prompt" >&2
        fi

        if ! IFS= read -r value; then
            break
        fi
        value="$(printf "%s" "$value" | strip_escape_sequences)"

        if [ -z "$value" ]; then
            if [ -n "${default_val:-}" ] && [ "$default_val" != "Your Name" ] && [ "$default_val" != "your-email@example.com" ]; then
                value="$default_val"
            else
                echo "⚠️  空入力は受け付けていません。もう一度入力してください。" >&2
            fi
        fi
    done

    printf "%s\n" "$value"
}

# Determine default user name without hardcoding personal identifiers
default_user="${USER:-}"
if [ "$default_user" = "root" ] || [ "$default_user" = "nobody" ]; then
    default_user=""
fi

name="$(prompt_value "Git user.name" "${default_user:-Your Name}")"

default_email=""
if [ -n "$name" ] && [ "$name" != "Your Name" ]; then
    default_email="${name}@users.noreply.github.com"
fi

email="$(prompt_value "Git user.email" "${default_email:-your-email@example.com}")"

if [ -z "$name" ] || [ -z "$email" ]; then
    echo "⚠️  Git user.name または user.email が未決定のため $self_gitconfig_path の自動作成をスキップしました。"
    echo "💡 必要に応じて 'git config --global user.name ...' 等を設定してください。"
    exit 0
fi

cat >"$self_gitconfig_path" <<EOF
[user]
    name = $name
    email = $email
EOF

echo "✅ $self_gitconfig_path を作成しました ($name <$email>)。"

