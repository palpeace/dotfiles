[init]
	defaultBranch = main
[core]
	# 日本語のファイル名をエスケープせずに表示する
	quotepath = false
[credential "https://github.com"]
	helper =
	helper = !~/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !~/.local/share/mise/shims/gh auth git-credential
# 仕事用の設定（メールアドレス等）はリポジトリ外の ~/.gitconfig.work に置く
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig.work
