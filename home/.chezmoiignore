# chezmoi自体の設定・管理用ファイル
.chezmoiroot
.chezmoiignore
.chezmoistate

# リポジトリのドキュメントやGit設定
.git/
.gitignore
README.md
LICENSE

# macOS特有の不要なファイル
**/.DS_Store

# スクリプトディレクトリ自体は展開不要
# (chezmoiは .chezmoiscripts 内のファイルを自動で実行しますが、ファイルとしてコピーはしません)
.chezmoiscripts/

# ローカル秘密 (トークン等)。git/chezmoi に絶対取り込まない。
.config/zsh/secrets.zsh
**/.ssh/**
**/.aws/**
**/.kube/config
**/.gnupg/**
**/*.pem
**/*.key

# アプリケーション認証情報の漏洩防止（死角の封鎖）
**/.config/gh/hosts.yml
**/.npmrc
**/.cargo/credentials
**/.cargo/credentials.toml
**/.docker/config.json
**/.netrc
**/.env
**/.env.*
# codex: ChatGPT ログインの資格情報。`codex doctor` が auth file として指す実体。
**/.codex/auth.json

# codex: 管理するのは AGENTS.md の symlink だけ。自己更新のバイナリ(320MB)・
# セッション履歴・sqlite・ログは再生成物か実行時状態なので入れない。
# `chezmoi add ~/.codex` を打ち間違えた時の死角を塞ぐためだけに列挙する。
.codex/packages
.codex/sessions
.codex/log
.codex/tmp
.codex/*.sqlite*
.codex/version.json
.codex/history.jsonl
