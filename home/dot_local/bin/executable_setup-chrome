#!/usr/bin/env bash
# browse（Stagehand の CLI）がローカルで使う Google Chrome を入れる。何度実行してもよい。
# Ubuntu の apt の chromium は snap 版で WSL では不安定なので、Google の deb 版を使う。
# 更新は apt（update-system）で入る。
set -euo pipefail

if dpkg -s google-chrome-stable >/dev/null 2>&1; then
  echo "Google Chrome: $(google-chrome --version)"
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt_opts=(-o DPkg::Lock::Timeout=300)

echo "==> Google Chrome の apt リポジトリを登録する"
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | sudo gpg --dearmor --yes -o /etc/apt/keyrings/google-chrome.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
  | sudo tee /etc/apt/sources.list.d/google-chrome.list >/dev/null

echo "==> Google Chrome を入れる"
sudo apt-get "${apt_opts[@]}" update
sudo apt-get "${apt_opts[@]}" install -y google-chrome-stable
echo "Google Chrome: $(google-chrome --version)"
