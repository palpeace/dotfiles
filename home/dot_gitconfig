[user]
	name = palpeace
	email = 47219060+palpeace@users.noreply.github.com
[init]
	defaultBranch = main
[core]
	# 日本語のファイル名をエスケープせずに表示する
	quotepath = false
	editor = micro
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[credential "https://github.com"]
	helper =
	helper = !~/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !~/.local/share/mise/shims/gh auth git-credential
# 仕事用の設定（メールアドレス等）はリポジトリ外の ~/.gitconfig.work に置き、~/repos/work/ の下でだけ読む
[includeIf "gitdir:~/repos/work/"]
	path = ~/.gitconfig.work
