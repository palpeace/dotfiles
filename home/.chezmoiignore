**/auth.json
**/.claude.json
**/hosts.yml
**/secrets.zsh
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.jsonl
**/*.log
.gitconfig.work
.zsh_history

# 鍵・クラウド・パッケージレジストリの認証情報
