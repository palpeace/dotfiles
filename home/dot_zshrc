# --- 1. システム設定 ---
# コマンドラインでの # (コメント) を有効にする
setopt interactive_comments
# 履歴設定
setopt share_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt inc_append_history
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_minus
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
export PATH="$HOME/.local/bin:$PATH"
typeset -U path PATH
export BROWSER='wslview'
export LESS='-FRX'
export EDITOR='micro'
export BAT_THEME='ansi'
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border=rounded --info=inline --preview-window=right:50%:wrap'

# --- 2. ツール起動 ---
if [ -x "$HOME/.local/bin/mise" ] || command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
if command -v sheldon >/dev/null 2>&1; then
  eval "$(sheldon source 2>/dev/null)"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if [[ -o interactive && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# 自前で #compdef を吐くツール（herdr 等）の置き場。生成は chezmoi の
# run_onchange_after_20-generate-completions が mise/config.toml の変化に合わせて行う。
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# compinit はツール初期化後に実行（zoxide/atuin の補完を拾うため）
autoload -Uz compinit
zmodload zsh/complist
compinit -C

# --- 3. 補完と候補表示 ---
[[ -d "$HOME/.cache/zsh/.zcompcache" ]] || mkdir -p "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches found%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' completer _extensions _complete _approximate

# --- 4. キーバインドと操作性 ---
# ↑↓ と Ctrl+R は atuin が自動でバインドする
bindkey '^F' autosuggest-accept



# --- 5. 開発環境メンテナンス ---
sync-dotfiles() {
  local diff_status=0

  chezmoi diff || diff_status=$?
  if [ "$diff_status" -gt 1 ]; then
    echo "chezmoi diff failed; aborting apply." >&2
    return "$diff_status"
  fi

  chezmoi apply
}

update-all() {
  chezmoi update &&
    update-system
}

# --- 6. エイリアス / ショートカット関数 ---
alias ls="eza --icons --git"
alias ll="eza -ahl --icons --git"
alias la="eza -a --icons --git"
alias tree="eza --tree --icons --git-ignore"
alias cat="bat --paging=never"

# rm はゴミ箱経由（FreeDesktop 準拠 / ~/.local/share/Trash）。
# 実体は pipx:trash-cli の trash-put。-r / -f は rm 互換で受け取る。
# 旧 npm:trash-cli は WSL を検知して powershell.exe を起動し、interop の無い
# 環境では ENOENT で落ちて「消したつもりで消えていない」状態を作っていた。
#   一覧: trash-list / 復元: trash-restore / 空に: trash-empty [日数]
#   ゴミ箱を経由せず即時削除したいとき: \rm ...
alias rm="trash-put"

alias ghs="gh auth switch"
alias cd="z"
alias gu="gitui"
alias ox="oxker"
# yazi を抜けたとき、最後にいたディレクトリへシェルも移動する (公式ラッパー相当)。
# 素の alias だと yazi で辿り着いた場所からそのまま AI を起動できない。
# cat=bat / rm=trash-put の alias があるため command 経由で素のコマンドを呼ぶこと。
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  command rm -f -- "$tmp"
}
alias mi="micro"
alias agy-a="agy --dangerously-skip-permissions"
# 起動時にモデル・権限を決めるので settings.json の既定値を汚さない。
# auto mode は「どの設定ソースも mode を指定していないときの既定」になった (2.1.251 で確認)。
# それでもフラグを明示するのは、既定化がプラン/ゲート配信依存で、settings.json に
# permissions.defaultMode が入った瞬間に既定から外れるため。明示すれば常に auto で確定する。
# 第1引数が effort レベルなら --effort として渡し、残りは claude にそのまま渡す。
# 例: opus xhigh "難しいタスク" / sonnet low / fable max
# 無指定ならモデルのカタログ既定 effort (Fable 5 / Opus 5 / Sonnet 5 は high、Opus 4.7 のみ xhigh)。
# 目安: low=軽い/低レイテンシ重視の作業, medium=コスト重視, high=既定(バランス),
#       xhigh=複雑な設計・デバッグ, max=難問向けだが過剰思考になりやすいので試してから常用する。
_cc_launch() {
  local model="$1" mode="$2"
  shift 2
  local effort=""
  case "${1:-}" in
    low | medium | high | xhigh | max) effort="$1"; shift ;;
  esac
  local args=(--permission-mode "$mode" --model "$model")
  [ -n "$effort" ] && args+=(--effort "$effort")
  claude "${args[@]}" "$@"
}
alias cc-a="claude --permission-mode auto"
# [1m] は Opus 5 / Sonnet 5 / Fable 5 では既にネイティブ 1M なのでほぼ no-op だが、
# 1M 付与ゲートに依らずウィンドウを 1M に固定できるので残している。Haiku は 200K なので付けない。
# Fable 5 は最難関・長時間タスク向けの最上位モデル。Opus の 2 倍単価 ($10/$50) で、
# 専用の週次上限を超えると usage credits (追加課金) を食うため常用モデルにはしない。
# 初回は使用同意ダイアログが出るので、対話セッションで一度承認してから -p で使うこと。
fable() { _cc_launch 'fable[1m]' auto "$@"; }
opus() { _cc_launch 'opus[1m]' auto "$@"; }
sonnet() { _cc_launch 'sonnet[1m]' auto "$@"; }
haiku() { claude --permission-mode auto --model haiku "$@"; } # Haiku は effort 非対応
cc-p-opus() { _cc_launch 'opus[1m]' plan "$@"; }
cc-p-fable() { _cc_launch 'fable[1m]' plan "$@"; }

# ローカル秘密 (git/chezmoi 管理外, ~/.config/zsh/secrets.zsh)。あれば読む。
[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh

# zoxide は chpwd フックを最後に登録する必要があるため、設定ファイルの末尾で初期化する。
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
