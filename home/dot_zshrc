# --- 1. システム設定 ---
# コマンドラインでの # (コメント) を有効にする
setopt interactive_comments
# 履歴設定
setopt share_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt inc_append_history
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_minus
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
export PATH="$HOME/.local/bin:$PATH"
typeset -U path PATH
export BROWSER='wslview'
export LESS='-FRX'
export EDITOR='micro'
export BAT_THEME='ansi'
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border=rounded --info=inline --preview-window=right:50%:wrap'

# --- 2. ツール起動 ---
if [ -x "$HOME/.local/bin/mise" ] || command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
if command -v sheldon >/dev/null 2>&1; then
  eval "$(sheldon source 2>/dev/null)"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if [[ -o interactive && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# compinit はツール初期化後に実行（zoxide/atuin の補完を拾うため）
autoload -Uz compinit
zmodload zsh/complist
compinit -C

# --- 3. 補完と候補表示 ---
[[ -d "$HOME/.cache/zsh/.zcompcache" ]] || mkdir -p "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches found%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' completer _extensions _complete _approximate

# --- 4. キーバインドと操作性 ---
# ↑↓ と Ctrl+R は atuin が自動でバインドする
bindkey '^F' autosuggest-accept



# --- 5. 開発環境メンテナンス ---
sync-dotfiles() {
  local diff_status=0

  chezmoi diff || diff_status=$?
  if [ "$diff_status" -gt 1 ]; then
    echo "chezmoi diff failed; aborting apply." >&2
    return "$diff_status"
  fi

  chezmoi apply
}

update-all() {
  chezmoi update &&
    update-system
}

# --- 6. エイリアス ---
alias ls="eza --icons --git"
alias ll="eza -ahl --icons --git"
alias la="eza -a --icons --git"
alias tree="eza --tree --icons --git-ignore"
alias cat="bat --paging=never"
alias rm="trash"

alias ghs="gh auth switch"
alias cd="z"
alias gu="gitui"
alias ox="oxker"
alias y="yazi"
alias mi="micro"
alias agy-a="agy --dangerously-skip-permissions"
# Claude Code を headroom(token圧縮)proxy 経由で起動。素の claude も残す二択。CLAUDE_HR_MODE=cache で切替
alias cch="$HOME/.local/headroom-experiment/claude-hr.sh"
alias cch-a="cch --permission-mode auto"
# cch-<権限>-<モデル>。起動時にモデルを決めるので settings.json の既定値を汚さない。
# 権限は a=auto / p=plan。他が要るなら --permission-mode の値をそのまま足す
# (acceptEdits / dontAsk / bypassPermissions / manual)。
alias cch-a-opus="cch --permission-mode auto --model 'opus[1m]'"
alias cch-a-sonnet="cch --permission-mode auto --model 'sonnet[1m]'"
alias cch-a-haiku="cch --permission-mode auto --model haiku"
alias cch-p-opus="cch --permission-mode plan --model 'opus[1m]'"

# ローカル秘密 (git/chezmoi 管理外, ~/.config/zsh/secrets.zsh)。あれば読む。
[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh

# zoxide は chpwd フックを最後に登録する必要があるため、設定ファイルの末尾で初期化する。
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
