#!/usr/bin/env bash
set -euo pipefail
trap 'echo "❌ setup-system failed unexpectedly at line $LINENO. (Command: $BASH_COMMAND)" >&2' ERR

PATH="$HOME/.local/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

SUDO_CMD=""
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            SUDO_CMD="sudo -n"
        elif [ "${NONINTERACTIVE:-0}" != "1" ] && [ -t 0 ]; then
            echo "🔐 sudo requires a password. Please authenticate:" >&2
            sudo -v
            SUDO_CMD="sudo"
        else
            echo "❌ ERROR: sudo password required but running in non-interactive mode." >&2
            exit 1
        fi
    else
        echo "❌ ERROR: Root access or functional sudo is required." >&2
        exit 1
    fi
else
    # Prevent direct root execution to avoid $HOME pollution unless SUDO_USER is set
    if [ -n "${SUDO_USER:-}" ] && [ "$HOME" = "/root" ]; then
        echo "❌ ERROR: setup-system invoked via sudo without preserving user HOME." >&2
        echo "💡 Rerun without sudo, or use 'sudo -E -u $SUDO_USER setup-system'." >&2
        exit 1
    fi
fi

base_apt_packages=(
    git
    curl
    zsh
    build-essential
    pkg-config
    libssl-dev
    unzip
    xz-utils
    bubblewrap
    fonts-noto-color-emoji
    # Python/Ruby 等ランタイムビルド用の必須ライブラリ
    zlib1g-dev
    libbz2-dev
    libreadline-dev
    libsqlite3-dev
    libffi-dev
    liblzma-dev
)

# Browser runtimes such as Chromium / Playwright need these shared libraries.
browser_runtime_apt_packages=(
    libnss3
    libnspr4
    # Work IQ 認証用。現 pin の 0.2.8 は browser auth → wslview(wslu)で Windows 側ブラウザを開く。
    wslu
    # 0.4.x/0.5.x の MSAL/WAM broker に戻したとき用(webkit2gtk が javascriptcoregtk/soup3 を依存で引く)。
    libwebkit2gtk-4.1-0
    libsecret-1-0
)

require_github_cli_auth() {
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        echo "✅ Using existing GITHUB_TOKEN from environment."
        return 0
    fi

    local gh_bin=""

    gh_bin="$(command -v gh 2>/dev/null || true)"

    if [ -z "$gh_bin" ]; then
        gh_bin="$("$HOME/.local/bin/mise" which gh 2>/dev/null || true)"
    fi

    if [ -z "$gh_bin" ] || [ ! -x "$gh_bin" ]; then
        echo "📦 Installing GitHub CLI directly without polluting config..."
        "$HOME/.local/bin/mise" install github-cli
        gh_bin="$("$HOME/.local/bin/mise" which gh 2>/dev/null || true)"
    fi

    if [ -z "$gh_bin" ] || [ ! -x "$gh_bin" ]; then
        echo "⚠️  GitHub CLI binary could not be resolved. Skipping gh auth setup." >&2
        return 0
    fi

    if "$gh_bin" auth status >/dev/null 2>&1; then
        export GITHUB_TOKEN="$("$gh_bin" auth token 2>/dev/null || echo "")"
    elif [ -t 0 ] && [ -t 1 ] && [ "${NONINTERACTIVE:-0}" != "1" ]; then
        echo "🔐 GitHub CLI authentication is recommended to prevent API rate limits (60/hr) on Aqua." >&2
        echo "💡 To authenticate, run: gh auth login --web" >&2
    else
        echo "⚠️  GitHub CLI is not authenticated. Skipping git credential helper setup." >&2
        echo "💡 Run 'gh auth login --web' after setup if needed." >&2
    fi
}

resolve_apt_package() {
    local package="$1"
    local policy_output=""

    policy_output="$(apt-cache policy "$package" 2>/dev/null || true)"

    if [[ "$policy_output" == *"Candidate: (none)"* ]]; then
        return 1
    fi

    if [[ "$policy_output" == *"Candidate:"* ]]; then
        printf '%s\n' "$package"
        return 0
    fi

    return 1
}

alsa_runtime_package="$(resolve_apt_package libasound2t64 || resolve_apt_package libasound2 || true)"

if [ -n "$alsa_runtime_package" ]; then
    browser_runtime_apt_packages+=("$alsa_runtime_package")
else
    echo "⚠️  Could not resolve an ALSA runtime package (tried libasound2t64, libasound2)." >&2
fi

# Switch to Japanese mirror (Yamagata University) if running in Ubuntu
jp_mirror="http://linux.yz.yamagata-u.ac.jp/ubuntu"
if [ "${USE_JP_MIRROR:-1}" = "1" ]; then
    echo "🌏 Switching apt mirror to Yamagata University (linux.yz.yamagata-u.ac.jp)..."
    for s_file in "/etc/apt/sources.list.d/ubuntu.sources" "/etc/apt/sources.list"; do
        if [ -f "$s_file" ] && [ -w "$s_file" ] || $SUDO_CMD test -w "$s_file" 2>/dev/null; then
            $SUDO_CMD sed -E -i "s|http://[a-z.]*archive.ubuntu.com/ubuntu/?|${jp_mirror}|g; s|http://security.ubuntu.com/ubuntu/?|${jp_mirror}|g; s|http://ftp.jaist.ac.jp/pub/Linux/ubuntu/?|${jp_mirror}|g" "$s_file" || true
        fi
    done
fi


wait_for_apt() {
    local timeout=60
    local elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        local locked=0
        for lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock; do
            if command -v fuser >/dev/null 2>&1; then
                if $SUDO_CMD fuser "$lock" >/dev/null 2>&1; then locked=1; break; fi
            elif command -v lsof >/dev/null 2>&1; then
                if $SUDO_CMD lsof "$lock" >/dev/null 2>&1; then locked=1; break; fi
            else
                if pgrep -f "apt|dpkg|unattended-upgr" >/dev/null 2>&1; then locked=1; break; fi
            fi
        done
        [ "$locked" -eq 0 ] && return 0
        echo "⏳ Waiting for apt lock to be released..."
        sleep 5
        elapsed=$((elapsed + 5))
    done
    echo "⚠️  Timeout waiting for apt lock. Proceeding anyway..." >&2
}

echo "🚀 Installing base system dependencies..."
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold")
wait_for_apt
$SUDO_CMD apt update
wait_for_apt
$SUDO_CMD apt install -y "${APT_OPTS[@]}" "${base_apt_packages[@]}" "${browser_runtime_apt_packages[@]}"

echo "🔤 Rebuilding font cache..."
fc-cache -fv

echo "🔎 Checking for Noto Color Emoji..."
if ! fc-list | grep -i "Noto Color Emoji"; then
    echo "⚠️  Noto Color Emoji was not found in fc-list output." >&2
fi

zsh_path="$(command -v zsh || true)"
if [ -n "$zsh_path" ] && [ "${SHELL:-}" != "$zsh_path" ]; then
    if ! grep -q "^${zsh_path}$" /etc/shells; then
        echo "🔧 Adding $zsh_path to /etc/shells..."
        echo "$zsh_path" | $SUDO_CMD tee -a /etc/shells >/dev/null
    fi
    echo "🔧 Switching login shell to zsh..."
    $SUDO_CMD usermod -s "$zsh_path" "$(whoami)"
elif [ -z "$zsh_path" ]; then
    echo "⚠️ zsh is not found in PATH, skipping login shell switch to prevent account breakage." >&2
fi

if ! command -v mise >/dev/null 2>&1; then
    echo "📦 Installing mise..."
    tmp_sh="$(mktemp)"
    if curl -fsSL https://mise.run -o "$tmp_sh"; then
        sh "$tmp_sh"
    else
        echo "❌ ERROR: Failed to download mise installer" >&2
        rm -f "$tmp_sh"
        exit 1
    fi
    rm -f "$tmp_sh"
fi

require_github_cli_auth

echo "📦 Installing managed tools with mise..."
export MISE_FETCH_REMOTE_VERSIONS_TIMEOUT="${MISE_FETCH_REMOTE_VERSIONS_TIMEOUT:-60}"
setup_failures=()

# mise does not resolve implicit backend dependencies (npm:→node, cargo:→rust).
# Runtimes are fatal — without them, npm:/cargo:/go: tools cannot install.
# MISE_QUIET suppresses warnings about unresolvable npm:/cargo: tools that
# depend on runtimes not yet installed at this point.
echo "📦 Installing runtimes (rust, node, go, python) first..."
MISE_QUIET=1 "$HOME/.local/bin/mise" install -y --jobs=1 rust node go python

eval "$("$HOME/.local/bin/mise" activate bash)"

# Remaining tools: report failures but continue so one broken tool doesn't
# block the entire environment.
echo "📦 Installing remaining tools..."
if ! "$HOME/.local/bin/mise" install -y; then
    setup_failures+=("mise install (some tools failed — rerun 'mise install' to retry)")
fi

# Do not unset GITHUB_TOKEN if it was passed from the environment for CI purposes.
# unset GITHUB_TOKEN

if ! command -v claude >/dev/null 2>&1; then
    echo "🤖 Installing Claude Code..."
    tmp_sh="$(mktemp)"
    if curl -fsSL https://claude.ai/install.sh -o "$tmp_sh"; then
        bash "$tmp_sh" || setup_failures+=("Claude Code")
    else
        setup_failures+=("Claude Code (Download failed)")
    fi
    rm -f "$tmp_sh"
fi

if ! command -v kiro-cli >/dev/null 2>&1; then
    echo "🤖 Installing Kiro CLI..."
    tmp_sh="$(mktemp)"
    if curl -fsSL https://cli.kiro.dev/install -o "$tmp_sh"; then
        bash "$tmp_sh" || setup_failures+=("Kiro CLI")
    else
        setup_failures+=("Kiro CLI (Download failed)")
    fi
    rm -f "$tmp_sh"
fi

if ! command -v agy >/dev/null 2>&1; then
    echo "🤖 Installing Antigravity CLI..."
    tmp_sh="$(mktemp)"
    if curl -fsSL https://antigravity.google/cli/install.sh -o "$tmp_sh"; then
        bash "$tmp_sh" || setup_failures+=("Antigravity CLI")
    else
        setup_failures+=("Antigravity CLI (Download failed)")
    fi
    rm -f "$tmp_sh"
fi

if [ ${#setup_failures[@]} -gt 0 ]; then
    echo "" >&2
    echo "⚠️  setup-system completed with errors:" >&2
    for f in "${setup_failures[@]}"; do
        echo "   - $f" >&2
    done
    echo "   Run 'setup-system' again to retry failed items." >&2
    exit 1
fi
