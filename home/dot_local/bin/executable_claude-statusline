#!/usr/bin/env bash
# Claude Code statusLine。~/.claude/settings.json の statusLine.command から呼ばれる。
# 表示例: ~/repos/trial (main) Opus 5 (1M context, high effort) │ CTX 1% │ 5H 1% (18:23) │ 1W 36% (木18:23) │ TTL 17:23
# CTX/5H/1W は 70%未満=dim(控えめ) 70-89%=黄 90%以上=赤 で警告表示する。
# 通常値をdimにして黄/赤だけを目立たせることで、項目が増えても警告箇所が一目でわかるようにする。
# TTL はプロンプトキャッシュ(サブスク課金では1h固定)の失効予定時刻。transcript の最終送信から1h後を計算する。
#
# 起動頻度が高いため、外部プロセスのforkを最小限に抑えている:
# - フィールド取得は jq を1回だけ呼び、@tsv でまとめて受け取る (個別に呼ぶと10回forkしていた)
# - 時刻整形は bash 組み込みの printf '%(FMT)T' / $EPOCHSECONDS を使い、date の呼び出しを避ける
#   (ISO-8601文字列のパースだけは bash に相当機能が無いため date -d を残す)
set -euo pipefail

DIM='\033[2m'
YELLOW='\033[33m'
RED='\033[31m'
BLUE='\033[34m'
MAGENTA='\033[35m'
RESET='\033[0m'

input="$(cat)"

IFS=$'\x1f' read -r dir model size ctx five_h week five_h_resets week_resets transcript_path effort < <(
  jq -r '[
    (.workspace.current_dir // .cwd // ""),
    (.model.display_name // ""),
    (.context_window.context_window_size // ""),
    (.context_window.used_percentage // ""),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.rate_limits.five_hour.resets_at // ""),
    (.rate_limits.seven_day.resets_at // ""),
    (.transcript_path // ""),
    (.effort.level // "")
  ] | map(tostring) | join("\u001f")' <<<"$input"
)

# $HOME 配下なら ~ に短縮する (例: /home/murai/repos/trial -> ~/repos/trial)
if [ -n "${HOME:-}" ] && [ "${dir#"$HOME"}" != "$dir" ]; then
  dir="~${dir#"$HOME"}"
fi

fmt_size() {
  local n="$1"
  [ -z "$n" ] && return
  if [ "$n" -ge 1000000 ]; then
    printf '%sM' "$((n / 1000000))"
  elif [ "$n" -ge 1000 ]; then
    printf '%sK' "$((n / 1000))"
  else
    printf '%s' "$n"
  fi
}

# resets_at (epoch秒) を絶対時刻 "HH:MM" にする。当日でなければ曜日を1文字前置する (例: 木18:23)。
# epoch 秒以外 (ISO-8601 等) が来たら算術エラーを出さずに黙って諦める。
fmt_remaining() {
  local resets_at="$1"
  [ -z "$resets_at" ] && return
  case "$resets_at" in
    ''|*[!0-9]*) return ;;
  esac
  local remaining=$((resets_at - EPOCHSECONDS))
  [ "$remaining" -le 0 ] && return
  local today reset_fields reset_day hm wd
  printf -v today '%(%Y-%m-%d)T' -1
  printf -v reset_fields '%(%Y-%m-%d %H:%M %u)T' "$resets_at"
  read -r reset_day hm wd <<<"$reset_fields"
  if [ "$today" = "$reset_day" ]; then
    printf '%s' "$hm"
  else
    local wdays=(月 火 水 木 金 土 日)
    printf '%s%s' "${wdays[$((wd - 1))]}" "$hm"
  fi
}

# 閾値に応じて "ラベル 値%(残り時間)" を色付けする。
colorize() {
  local label="$1" pct_raw="$2" resets_at="${3:-}"
  [ -z "$pct_raw" ] && return
  local pct
  pct=$(printf '%.0f' "$pct_raw")
  local color="$DIM"
  if [ "$pct" -ge 90 ]; then
    color="$RED"
  elif [ "$pct" -ge 70 ]; then
    color="$YELLOW"
  fi
  local remaining
  remaining=$(fmt_remaining "$resets_at")
  if [ -n "$remaining" ]; then
    printf '%b%s %s%% (%s)%b' "$color" "$label" "$pct" "$remaining" "$RESET"
  else
    printf '%b%s %s%%%b' "$color" "$label" "$pct" "$RESET"
  fi
}

# transcript(JSONL)の最終エントリの timestamp + 1h = プロンプトキャッシュTTL失効予定時刻。
# 1h経過済み(キャッシュが冷えている)場合は何も出さない。
fmt_cache_ttl() {
  local path="$1"
  if [ -z "$path" ] || [ ! -f "$path" ]; then
    return 0
  fi
  # ファイル全体を tac すると長時間セッション(数MB〜十数MB)で重くなるため、
  # 末尾64KBだけを対象にする。それでtimestampが拾えなければ全体にフォールバックする。
  local last_ts
  last_ts=$(tail -c 65536 "$path" 2>/dev/null | tac 2>/dev/null | jq -r 'select(.timestamp != null) | .timestamp' 2>/dev/null | head -1) || true
  if [ -z "$last_ts" ]; then
    last_ts=$(tac "$path" 2>/dev/null | jq -r 'select(.timestamp != null) | .timestamp' 2>/dev/null | head -1) || true
  fi
  if [ -z "$last_ts" ]; then
    return 0
  fi
  local last_epoch
  last_epoch=$(date -d "$last_ts" +%s 2>/dev/null) || true
  if [ -z "$last_epoch" ]; then
    return 0
  fi
  local expiry=$((last_epoch + 3600))
  local remaining=$((expiry - EPOCHSECONDS))
  if [ "$remaining" -le 0 ]; then
    return 0
  fi
  local color="$DIM"
  if [ "$remaining" -le 600 ]; then
    color="$RED"
  elif [ "$remaining" -le 1800 ]; then
    color="$YELLOW"
  fi
  local expiry_hm
  printf -v expiry_hm '%(%H:%M)T' "$expiry"
  printf '%bTTL %s%b' "$color" "$expiry_hm" "$RESET"
}

# モデル名に応じて色を変える。Opus系=赤、Sonnet系=青、それ以外=マゼンタ
model_color() {
  local name="$1"
  case "$name" in
    *Opus*) printf '%s' "$RED" ;;
    *Sonnet*) printf '%s' "$BLUE" ;;
    *) printf '%s' "$MAGENTA" ;;
  esac
}

size_fmt=$(fmt_size "$size")

# display_name が将来 "(1M context)" 等を自前で付与してきても二重表示にならないよう、
# 既存の末尾括弧書きは一旦剥がしてから size/effort を付け直す。
model="${model%% (*}"

info_parts=()
[ -n "$size_fmt" ] && info_parts+=("$size_fmt context")
[ -n "$effort" ] && info_parts+=("$effort effort")
if [ ${#info_parts[@]} -gt 0 ]; then
  joined=$(printf ', %s' "${info_parts[@]}")
  model="$model (${joined#, })"
fi

mcolor=$(model_color "$model")
model_fmt=$(printf '%b%s%b' "$mcolor" "$model" "$RESET")

# dir が空だと git が statusline プロセスの cwd を見て無関係なブランチを表示する。
branch=""
[ -n "$dir" ] && branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)

line="$dir"
[ -n "$branch" ] && line="$line ($branch)"
line="$line $model_fmt"
for part in "$(colorize CTX "$ctx")" "$(colorize 5H "$five_h" "$five_h_resets")" "$(colorize 1W "$week" "$week_resets")" "$(fmt_cache_ttl "$transcript_path")"; do
  [ -n "$part" ] && line="$line │ $part"
done

printf '%s\n' "$line"
