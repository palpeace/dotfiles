# chezmoi自体の設定・管理用ファイル
.chezmoiroot
.chezmoiignore
.chezmoistate

# リポジトリのドキュメントやGit設定
.git/
.gitignore
README.md
LICENSE

# macOS特有の不要なファイル
**/.DS_Store

# スクリプトディレクトリ自体は展開不要
# (chezmoiは .chezmoiscripts 内のファイルを自動で実行しますが、ファイルとしてコピーはしません)
.chezmoiscripts/

# ローカル秘密 (トークン等)。git/chezmoi に絶対取り込まない。
.config/zsh/secrets.zsh
**/.ssh/**
**/.aws/**
**/.kube/config
**/.gnupg/**
**/*.pem
**/*.key

# アプリケーション認証情報の漏洩防止（死角の封鎖）
**/.config/gh/hosts.yml
**/.npmrc
**/.cargo/credentials
**/.cargo/credentials.toml
**/.docker/config.json
**/.netrc
**/.env
**/.env.*

# headroom: venv(再生成可・622MB)・実行時状態(CCR=原文含む機密)・検証データは管理しない。
# env.sh / claude-hr.sh / install.sh は管理し、venv は install.sh で明示再生成する。
.local/headroom-experiment/venv
.local/headroom-experiment/state
.local/headroom-experiment/trial
