{{/*
  chezmoi の設定。**「この機械に何を入れるか」を聞く場所はここ1つ。**
  答えは `chezmoi init` の時に一度だけ聞かれ、~/.config/chezmoi/chezmoi.toml に
  焼かれる（promptBoolOnce は既に答えがあれば聞き直さない）。

  スクリプト側で「入っていなければ入れる」と判定しない —— それは機械の現状を
  見ているだけで、**その機械に入れたいのかを一度も聞いていない**。

  **ここでは .chezmoidata.toml の値を参照できない**（init の文脈では data ファイルが
  読まれておらず、`map has no entry for key` で落ちる。2026-09-02 実測）。だから
  既定値はこのファイルにリテラルで書く。.chezmoidata.toml 側の同名の既定は、
  この config をまだ作っていない機械のためのもの。

  stdinIsATTY で囲むのは、端末が無い経路（scripts/verify-in-docker.sh の
  `chezmoi init --apply` や NONINTERACTIVE=1 の bootstrap）で prompt が
  落ちるのを避けるため。その場合は既定値のまま進む。
*/ -}}
{{- $sshServer := false -}}
{{- if stdinIsATTY -}}
{{-   $sshServer = promptBoolOnce . "ssh_server" "この端末に sshd を入れますか（LAN内の別PCから ssh で入る）" false -}}
{{- end -}}

[data]
ssh_server = {{ $sshServer }}
