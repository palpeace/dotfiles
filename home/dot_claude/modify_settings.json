#!/bin/sh
# chezmoi が「今の ~/.claude/settings.json」を標準入力で渡してくる。
# その中身を土台に、管理したいキーだけ上書きして出力する。
# こうしないと CC が実行時に書くキー (model / effortLevel / fastMode 等) が apply のたび消える。
set -eu
input=$(cat)
[ -z "$input" ] && input='{}'

# jq が無い環境 (初回 bootstrap 等) では既存内容をそのまま返して apply を通す。
# ここで落ちると .claude/ 以降の全ターゲットが配置されないまま apply が中断する。
if ! command -v jq >/dev/null 2>&1; then
    printf '%s' "$input"
    exit 0
fi
# 稼働状況の可視化 (Pull ではなく Push で気づくための3層):
#   terminalProgressBarEnabled  長時間処理中に OSC 9;4 を吐く。Windows Terminal が
#                               タブとタスクバーに進捗を出すので「動いてるか」がタブで分かる。
#                               CC 側の既定が元々 true なのでこれは明示ピン留め。将来の
#                               既定変更に引きずられないためだけに書いている。
#   preferredNotifChannel       入力待ちでベルを鳴らす。WT 側 bellStyle=["window","taskbar"]
#                               と組で、待機に入った瞬間にタスクバーが点滅する。
#   inputNeededNotifEnabled     権限プロンプト/質問が待っているときモバイルへ push (離席用)。
#   disableAgentView           `claude agents` / --bg / /background / on-demand daemon を無効化。
#                               WSL2 で agent view (常駐監視プロセス) が重く感じたため停止。
#
# なお showStatusInTerminalTab / taskCompleteNotifEnabled はここに書いても無視される。
# settings.json が受理するキーは固定リストで、この2つは ~/.claude.json (グローバル config)
# 側のキーであり、かつ 2.1.229 時点でフィーチャーゲート未配信・実装未完のため。
# jq が落ちても apply 全体を道連れにしない。
# settings.json は CC が実行時に書くファイルで、クラッシュ・書き込み途中・ディスク満杯
# などで壊れた JSON になることが実際にある。ここで非ゼロ終了すると chezmoi apply は
# 辞書順で最初のターゲット (.claude/) で中断し、.config/ .local/bin/ .zshrc .gitconfig が
# 「1つも配置されないまま」成功も失敗も分からず終わる (AGENTS.md「chezmoi の落とし穴」)。
# 壊れた入力はそのまま素通しする。ここで修復すると CC の実行時キーを取りこぼすため、
# 直すのは CC 自身の仕事にして、こちらは apply を止めないことだけに責任を持つ。
if merged=$(printf '%s' "$input" | jq '. * {
  skipDangerousModePermissionPrompt: true,
  theme: "auto",
  tui: "fullscreen",
  terminalProgressBarEnabled: true,
  preferredNotifChannel: "terminal_bell",
  inputNeededNotifEnabled: true,
  disableAgentView: true,
  statusLine: { type: "command", command: "$HOME/.local/bin/claude-statusline" }
}' 2>/dev/null) && [ -n "$merged" ]; then
    printf '%s' "$merged"
else
    echo "warning: ~/.claude/settings.json を JSON として読めないため、管理キーを適用せず現状のまま残しました。" >&2
    printf '%s' "$input"
fi
