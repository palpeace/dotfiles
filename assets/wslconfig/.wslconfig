# =================================================================
# WSL2 Auto-Scaling & Resource Optimization for Orca IDE
# =================================================================
[wsl2]
# Orca のマルチエージェント並行処理用リソース上限設定
# ⚠️ 敵対的レビュー修正: メモリのハードコード(16GB)は、ホストPCのスペック次第でWindowsをOOMクラッシュさせるため削除。
# 指定なしの場合、WSLがホストメモリの50%を自動で動的割り当てします。
# memory=16GB
# processors=8
# swap=4GB

# --- AUTO-SCALING & MEMORY RECLAIM ---
# 1. autoMemoryReclaim: gradual に設定し、I/O キャッシュの全開放による Disk スラッシングを防ぐ
autoMemoryReclaim=gradual

# 2. sparseVhd: 仮想ディスク容量を使用量に応じて全自動縮小・オートリサイクル
# ⚠️ 複数 worktree での並列大容量書き込み時は競合リスクがあるため注視すること
sparseVhd=true

# --- NETWORK & SYSTEM AUTO-TUNING ---
# 3. networkingMode: Windows - WSL 間のネットワーク通信をミラー化し超高速化
# ⚠️ 敵対的レビュー修正: MirroredモードはVPNやDockerのポートフォワーディングを破壊する致命的リスクがあるため無効化。
# networkingMode=mirrored
# autoProxy=true
# dnsTunneling=true
