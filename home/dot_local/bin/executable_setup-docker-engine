#!/usr/bin/env bash
# Docker Engine を Ubuntu（WSL2）に直接入れる。何度実行してもよい。
# Docker Desktop は使わない。
# Windows 側に NVIDIA のドライバがある端末では、NVIDIA Container Toolkit も入れて
# コンテナから GPU を使えるようにする（docker run --gpus all）。
# WSL の中に Linux 用の NVIDIA ドライバは入れない（Windows 側のドライバを使う）。
set -euo pipefail

. /etc/os-release
if [ "${ID:-}" != "ubuntu" ] || [ -z "${VERSION_CODENAME:-}" ]; then
  echo "setup-docker-engine: Ubuntu だけに対応している" >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt_opts=(-o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

if ! dpkg -s docker-ce >/dev/null 2>&1; then
  echo "==> Docker の apt リポジトリを登録する"
  sudo apt-get "${apt_opts[@]}" update
  sudo apt-get "${apt_opts[@]}" install -y ca-certificates curl
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo tee /etc/apt/keyrings/docker.asc >/dev/null
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
    "$(dpkg --print-architecture)" "$VERSION_CODENAME" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null

  echo "==> Docker Engine を入れる"
  sudo apt-get "${apt_opts[@]}" update
  sudo apt-get "${apt_opts[@]}" install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# sudo なしで docker を使えるようにする（反映は新しいログインから）
if ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
  sudo groupadd -f docker
  sudo usermod -aG docker "$USER"
  echo "docker グループに追加した。WSL を開き直すと sudo なしで使える。"
fi

sudo systemctl enable --now docker
systemctl is-active --quiet docker || { echo "docker が起動していない" >&2; exit 1; }
echo "Docker Engine: $(docker --version)"

# NVIDIA GPU: WSL は Windows のドライバがあると /usr/lib/wsl/lib/nvidia-smi を置く。それを判定に使う。
if [ ! -x /usr/lib/wsl/lib/nvidia-smi ]; then
  echo "NVIDIA の GPU は無いので、NVIDIA Container Toolkit は入れない"
  exit 0
fi

if ! dpkg -s nvidia-container-toolkit >/dev/null 2>&1; then
  echo "==> NVIDIA Container Toolkit の apt リポジトリを登録する"
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
    | sudo gpg --dearmor --yes -o /etc/apt/keyrings/nvidia-container-toolkit.gpg
  curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
    | sed 's#deb https://#deb [signed-by=/etc/apt/keyrings/nvidia-container-toolkit.gpg] https://#g' \
    | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null

  echo "==> NVIDIA Container Toolkit を入れる"
  sudo apt-get "${apt_opts[@]}" update
  sudo apt-get "${apt_opts[@]}" install -y nvidia-container-toolkit
fi

# Docker に nvidia ランタイムを登録する（済んでいれば何も変わらない）
if ! grep -q nvidia /etc/docker/daemon.json 2>/dev/null; then
  sudo nvidia-ctk runtime configure --runtime=docker
  sudo systemctl restart docker
fi
echo "NVIDIA Container Toolkit: $(nvidia-ctk --version | head -1)"
echo "確かめる: docker run --rm --gpus all ubuntu nvidia-smi"
