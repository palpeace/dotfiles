#!/usr/bin/env bash
# No -e: each step catches its own errors and reports failures at the end.
set -uo pipefail

PATH="$HOME/.local/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

SUDO_CMD=""
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            SUDO_CMD="sudo -n"
        elif [ "${NONINTERACTIVE:-0}" != "1" ] && [ -t 0 ]; then
            echo "🔐 sudo requires a password. Please authenticate:" >&2
            sudo -v
            SUDO_CMD="sudo"
        else
            echo "❌ ERROR: sudo password required but running in non-interactive mode." >&2
            exit 1
        fi
    else
        echo "❌ ERROR: Root access or functional sudo is required." >&2
        exit 1
    fi
fi

wait_for_apt() {
    local timeout=60
    local elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        local locked=0
        for lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock; do
            if command -v fuser >/dev/null 2>&1; then
                if $SUDO_CMD fuser "$lock" >/dev/null 2>&1; then locked=1; break; fi
            elif command -v lsof >/dev/null 2>&1; then
                if $SUDO_CMD lsof "$lock" >/dev/null 2>&1; then locked=1; break; fi
            else
                if $SUDO_CMD test -f "$lock" && [ "$($SUDO_CMD stat -c %s "$lock" 2>/dev/null || echo 0)" -gt 0 ]; then locked=1; break; fi
            fi
        done
        [ "$locked" -eq 0 ] && return 0
        echo "⏳ Waiting for apt lock to be released..."
        sleep 5
        elapsed=$((elapsed + 5))
    done
    echo "⚠️  Timeout waiting for apt lock. Proceeding anyway..." >&2
}

update_failures=()

if command -v chezmoi >/dev/null 2>&1; then
    echo "🏠 Applying latest chezmoi dotfiles..."
    if ! chezmoi apply --force; then
        update_failures+=("chezmoi apply")
    fi
fi

echo "📦 Updating OS packages..."
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold")
wait_for_apt
if ! { $SUDO_CMD apt update && wait_for_apt && $SUDO_CMD apt upgrade -y "${APT_OPTS[@]}" && wait_for_apt && $SUDO_CMD apt autoremove -y; }; then
    update_failures+=("apt upgrade")
fi

if [ -x "$HOME/.local/bin/mise" ]; then
    if command -v rustup >/dev/null 2>&1; then
        echo "🦀 Updating rustup and Rust stable toolchain..."
        rustup self update 2>/dev/null || true
        if ! rustup update stable; then
            update_failures+=("rustup update stable")
        fi
    else
        echo "⏭️  rustup is not installed; skipping Rust toolchain update."
    fi

    # mise 自身の更新。**これが無いと mise だけ永久に古いまま残る** ——
    # 2026-09-07 に実測で 2026.8.5 が入っていて 2026.9.1 が出ており、
    # `mise upgrade` (管理下のツールを上げる) はこれを含まない。rustup 側に
    # `rustup self update` があるのと同じ位置づけ。
    echo "🧰 Updating mise itself..."
    if ! "$HOME/.local/bin/mise" self-update -y; then
        update_failures+=("mise self-update")
    fi

    echo "📦 Upgrading managed tools..."
    if ! "$HOME/.local/bin/mise" upgrade; then
        update_failures+=("mise upgrade")
    fi
    echo "🧹 Pruning unused managed tool installs..."
    "$HOME/.local/bin/mise" prune || true
    # **`mise prune` は消したと言わずに消さない**(mise 2026.8.5 実測)。
    # `mise prune --dry-run` は "go@1.24.13 uninstall / ✓ done" と出すのに、
    # 素で走らせると "pruned configuration links" だけ出して終了0を返し、
    # インストールは残る (`mise ls --prunable` に出たまま。tool 名を明示しても同じ)。
    # 消す時は `mise uninstall <tool>@<version>`。ここでは消し残りを見えるようにする
    # だけにして、削除は人の操作に残す。**この節は次に mise を上げた時に再測する。**
    prunable="$("$HOME/.local/bin/mise" ls --prunable 2>/dev/null || true)"
    if [ -n "$prunable" ]; then
        echo "⚠️  未使用のツールが残っています (消すなら mise uninstall <tool>@<version>):" >&2
        printf '%s\n' "$prunable" >&2
    fi
else
    echo "⏭️  mise is not installed; skipping tool upgrades."
fi

if command -v sheldon >/dev/null 2>&1; then
    echo "🔌 Updating Zsh plugins..."
    if ! sheldon lock --update; then
        update_failures+=("sheldon lock --update")
    fi
else
    echo "⏭️  sheldon is not installed; skipping plugin updates."
fi

if command -v claude >/dev/null 2>&1; then
    echo "🤖 Updating Claude Code..."
    if ! claude update; then
        update_failures+=("claude update")
    fi
else
    echo "⏭️  claude is not installed; skipping Claude Code update."
fi
if command -v agy >/dev/null 2>&1; then
    echo "🤖 Updating Antigravity CLI..."
    if ! agy update; then
        update_failures+=("agy update")
    fi
else
    echo "⏭️  agy is not installed; skipping Antigravity update."
fi
if command -v codex >/dev/null 2>&1; then
    echo "🤖 Updating Codex CLI..."
    if ! codex update; then
        update_failures+=("codex update")
    fi
    # 補完はバージョンに縛られる。codex は mise のピンの外で自己更新するので、
    # chezmoi の run_onchange (mise/config.toml のハッシュで発火) では追随しない。
    # 版が動きうる場所はここなので、ここで焼き直す。
    comp_dir="$HOME/.local/share/zsh/site-functions"
    mkdir -p "$comp_dir"
    codex completion zsh >"$comp_dir/_codex" 2>/dev/null ||
        update_failures+=("codex completion zsh")
    # **関数名が新規の時だけダンプの作り直しが要る。** ~/.zshrc は `compinit -C`
    # （ダンプを検証せずに読む）なので、_codex を置いただけでは拾われず、
    # 補完を生成したのに一度も読まれない状態が無言で作れる（2026-09-07 に実測。
    # `${+_comps[codex]}` が 0 のままだった）。中身の更新だけなら不要だが、
    # 「ここで初めて生成された」場合を区別できないので毎回消す（次のシェルが作る）。
    rm -f "$HOME"/.zcompdump*
else
    echo "⏭️  codex is not installed; skipping Codex CLI update."
fi





if [ ${#update_failures[@]} -gt 0 ]; then
    echo "" >&2
    echo "⚠️  update-system completed with errors:" >&2
    for f in "${update_failures[@]}"; do
        echo "   - $f" >&2
    done
    echo "   Run 'update-system' again to retry." >&2
    exit 1
fi
