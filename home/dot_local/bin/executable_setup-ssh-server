#!/usr/bin/env bash
set -euo pipefail

PATH="$HOME/.local/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

# LAN内の別PCから ssh で入るための OpenSSH server。
#
# 入れるかどうかを決めるのは configure-machine が machine.env に書いた
# DOTFILES_SSH_SERVER で、このスクリプトではない。ここが持つのは「入れると
# 決めた機械に何を置くか」だけ。
#
# **誰が入れるか (~/.ssh/authorized_keys) は持たない。** サーバを入れることと、
# 特定の鍵にアクセスを許すことは別の判断で、後者は git に載せない
# (.chezmoiignore の **/.ssh/** も同じ線引き)。
#
# Windows側の portproxy / ファイアウォール / 接続元の設定を含む経路の全体像は
# agex の bundles/meta/remote-access.md にある。

if [ ! -r /etc/os-release ]; then
    echo "/etc/os-release is not readable." >&2
    exit 1
fi

. /etc/os-release

if [ "${ID:-}" != "ubuntu" ]; then
    echo "setup-ssh-server currently supports Ubuntu only." >&2
    exit 1
fi

# 入れるかどうかの判断は machine.env で済んでいる。この分岐は再実行を速くする
# ための冪等性 (apt update を毎回走らせない) であって、導入可否の判定ではない。
if ! dpkg -s openssh-server >/dev/null 2>&1; then
    echo "📦 Installing openssh-server..."
    sudo apt update
    sudo apt install -y openssh-server
fi

# Include は sshd_config の先頭にあり、先に読まれた値が勝つ。10- で始めることで
# 50-cloud-init.conf 等より先に効く。
#
# Port を書かない。Ubuntu 24.04 は ssh.socket による socket 起動が既定で、その
# 場合 sshd_config の Port は黙って無視される (待受を決めるのは unit の
# ListenStream)。外向きのポート番号は接続側 (WSLなら Windows の portproxy) で決める。
conf_path="/etc/ssh/sshd_config.d/10-dotfiles.conf"
tmp_conf="$(mktemp)"
trap 'rm -f "$tmp_conf"' EXIT

cat >"$tmp_conf" <<CONF
# Generated by setup-ssh-server. Re-run it instead of editing in place.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers $(id -un)
X11Forwarding no
CONF

if sudo cmp -s "$tmp_conf" "$conf_path" 2>/dev/null; then
    echo "⏭️  $conf_path is up to date."
else
    echo "🔧 Writing $conf_path"
    sudo install -m 0644 -o root -g root "$tmp_conf" "$conf_path"
fi

if [ "$(systemctl is-enabled ssh.socket 2>/dev/null || true)" = "enabled" ]; then
    unit="ssh.socket"
else
    unit="ssh.service"
fi

sudo systemctl enable --now "$unit"
sudo systemctl restart "$unit"

# 「設定を書いた」で終わらせない。待ち受けていなければ失敗として落とす。
if ss -tln | grep -qE ':22[[:space:]]'; then
    echo "✅ sshd listening on 22 ($unit)"
else
    echo "❌ sshd is not listening on 22 ($unit)." >&2
    exit 1
fi

if [ ! -s "$HOME/.ssh/authorized_keys" ]; then
    echo "ℹ️  ~/.ssh/authorized_keys is empty — nobody can log in until you add a public key."
    echo "   Keys are placed by hand on each machine and never committed."
fi
