# --- 1. システム設定 ---
# コマンドラインでの # (コメント) を有効にする
setopt interactive_comments
# 履歴設定
setopt share_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt inc_append_history
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_minus
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
export PATH="$HOME/.local/bin:$PATH"
typeset -U path PATH
export BROWSER='wslview'
export LESS='-FRX'
export EDITOR='hx'
export BAT_THEME='ansi'
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border=rounded --info=inline --preview-window=right:50%:wrap'

# --- 2. ツール起動 ---
if [ -x "$HOME/.local/bin/mise" ] || command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
if command -v sheldon >/dev/null 2>&1; then
  eval "$(sheldon source 2>/dev/null)"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if [[ -o interactive && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# compinit はツール初期化後に実行（zoxide/atuin の補完を拾うため）
autoload -Uz compinit
zmodload zsh/complist
compinit -C

# --- 3. 補完と候補表示 ---
[[ -d "$HOME/.cache/zsh/.zcompcache" ]] || mkdir -p "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches found%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/.zcompcache"
zstyle ':completion:*' completer _extensions _complete _approximate

# --- 4. キーバインドと操作性 ---
# ↑↓ と Ctrl+R は atuin が自動でバインドする
bindkey '^F' autosuggest-accept

# fzf --zsh が定義する fzf-cd-widget を fd + eza プレビュー版で上書き
fzf-cd-widget() {
  local dir

  dir="$(
    fd --type d --hidden --follow --exclude .git . "${1:-.}" 2>/dev/null |
      fzf --height 40% --reverse --prompt='cd > ' --preview 'eza --all --icons --group-directories-first --color=always {}'
  )" || return

  BUFFER="cd ${dir:q}"
  zle accept-line
}
zle -N fzf-cd-widget
bindkey '^J' fzf-cd-widget

# --- 5. 開発環境メンテナンス ---
project-root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

has-just-recipe() {
  command -v just >/dev/null 2>&1 || return 1
  [ -f Justfile ] || [ -f justfile ] || return 1
  just --summary 2>/dev/null | tr ' ' '\n' | rg -qx "$1"
}

has-package-script() {
  [ -f package.json ] || return 1
  jq -e --arg name "$1" '.scripts[$name] != null' package.json >/dev/null 2>&1
}

is-node-worktree() {
  [ -f package.json ] || [ -f pnpm-lock.yaml ] || [ -f turbo.json ]
}

is-rust-worktree() {
  [ -f Cargo.toml ] || [ -f Cargo.lock ]
}

is-markdown-worktree() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files | rg -q '\.(md|mdx)$'
  else
    find . -maxdepth 3 \( -name "*.md" -o -name "*.mdx" \) 2>/dev/null | rg -q .
  fi
}

sync-dotfiles() {
  local diff_status=0

  chezmoi diff || diff_status=$?
  if [ "$diff_status" -gt 1 ]; then
    echo "chezmoi diff failed; aborting apply." >&2
    return "$diff_status"
  fi

  chezmoi apply
}

update-all() {
  chezmoi update &&
    update-system
}

dev() {
  (
    local root
    root="$(project-root)"
    cd "$root" || exit 1

    if has-just-recipe dev; then
      just dev
      exit 0
    fi

    if is-node-worktree; then
      if command -v pnpm >/dev/null 2>&1; then
        if [ -f package.json ] && has-package-script dev; then
          pnpm dev
        else
          echo "Node workspace detected."
          echo "Use 'pnpm install' if needed, then run the project-specific dev command."
        fi
      else
        echo "pnpm is not installed. Run setup-system first." >&2
        exit 1
      fi
      exit 0
    fi

    if is-rust-worktree; then
      if command -v bacon >/dev/null 2>&1; then
        bacon
      else
        cargo run
      fi
      exit 0
    fi

    if is-markdown-worktree; then
      echo "Markdown workspace detected."
      echo "Use 'check' to run prettier / markdownlint checks."
      exit 0
    fi

    echo "No supported project type detected in $root." >&2
    echo "Expected Justfile/justfile, package.json, Cargo.toml, or Markdown files." >&2
    exit 1
  )
}

check() {
  (
    local root
    root="$(project-root)"
    cd "$root" || exit 1

    if has-just-recipe check; then
      just check
      exit 0
    fi

    if is-rust-worktree; then
      cargo fmt --check &&
        cargo clippy --all-targets --all-features -- -D warnings &&
        { command -v cargo-nextest >/dev/null 2>&1 && cargo nextest run || cargo test; }
      exit 0
    fi

    if is-node-worktree; then
      if ! command -v pnpm >/dev/null 2>&1; then
        echo "pnpm is not installed. Run setup-system first." >&2
        exit 1
      fi

      local ran=0

      if has-package-script lint; then
        pnpm lint || exit 1
        ran=1
      fi

      if has-package-script typecheck; then
        pnpm typecheck || exit 1
        ran=1
      fi

      if has-package-script test; then
        pnpm test || exit 1
        ran=1
      fi

      if command -v prettier >/dev/null 2>&1; then
        prettier --check . || exit 1
        ran=1
      fi

      if [ "$ran" -eq 0 ]; then
        echo "No supported package.json checks found." >&2
        exit 1
      fi

      exit 0
    fi

    if is-markdown-worktree; then
      local ran=0

      if command -v prettier >/dev/null 2>&1; then
        prettier --check . || exit 1
        ran=1
      fi

      if command -v markdownlint-cli2 >/dev/null 2>&1; then
        markdownlint-cli2 "**/*.md" "**/*.mdx" || exit 1
        ran=1
      fi

      if [ "$ran" -eq 0 ]; then
        echo "No Markdown check tools found. Run setup-system first." >&2
        exit 1
      fi

      exit 0
    fi

    echo "No supported project type detected in $root." >&2
    echo "Expected Justfile/justfile, package.json, Cargo.toml, or Markdown files." >&2
    exit 1
  )
}

# --- 6. エイリアス ---
alias ls="eza --icons --git"
alias ll="eza -ahl --icons --git"
alias la="eza -a --icons --git"
alias tree="eza --tree --icons --git-ignore"
alias cat="bat --paging=never"
alias cd="z"
alias lg="lazygit"
alias ld="lazydocker"
alias ze="zed ."
# Orca GUI をカレントディレクトリで開く。`orca` は名乗らない —
# WSL では Orca が ORCA_CLI_COMMAND=orca-ide を export し、エージェントは
# `orca-ide` / `orca` を CLI として呼ぶ。ここで shadow すると CLI が黙って GUI を開く。
orca-app() {
  local target="${1:-.}"
  local win_user="${WINDOWS_USER:-$USER}"
  local orca_exe="/mnt/c/Users/${win_user}/AppData/Local/Programs/Orca/Orca.exe"
  if [ -f "$orca_exe" ]; then
    "$orca_exe" "$(wslpath -w "$target" 2>/dev/null || echo "$target")" &>/dev/null &
  elif command -v Orca.exe >/dev/null 2>&1; then
    Orca.exe "$(wslpath -w "$target" 2>/dev/null || echo "$target")" &>/dev/null &
  else
    echo "⚠️ Orca.exe was not found at $orca_exe" >&2
    return 1
  fi
}
alias agy-a="agy --dangerously-skip-permissions"
# Claude Code を headroom(token圧縮)proxy 経由で起動。素の claude も残す二択。CLAUDE_HR_MODE=cache で切替
alias cch="$HOME/.local/headroom-experiment/claude-hr.sh"
alias cch-a="cch --permission-mode auto"
# cch-<権限>-<モデル>。起動時にモデルを決めるので settings.json の既定値を汚さない。
# 権限は a=auto / p=plan。他が要るなら --permission-mode の値をそのまま足す
# (acceptEdits / dontAsk / bypassPermissions / manual)。
alias cch-a-opus="cch --permission-mode auto --model 'opus[1m]'"
alias cch-a-sonnet="cch --permission-mode auto --model 'sonnet[1m]'"
alias cch-a-haiku="cch --permission-mode auto --model haiku"
alias cch-p-opus="cch --permission-mode plan --model 'opus[1m]'"

# ローカル秘密 (git/chezmoi 管理外, ~/.config/zsh/secrets.zsh)。あれば読む。
[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh

# zoxide は chpwd フックを最後に登録する必要があるため、設定ファイルの末尾で初期化する。
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
