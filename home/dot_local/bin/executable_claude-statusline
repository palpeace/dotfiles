#!/usr/bin/env bash
# Claude Code statusLine。~/.claude/settings.json の statusLine.command から呼ばれる。
# 表示例: ~/repos/app (main) Opus 5 1M high │ CTX 1% │ TTL 17:23 │ CC 5H 75% (18:23) 1W 36% │ CX 5H 48% 1W 30%
# CC は Claude Code、CX は Codex の 5時間枠(5H)と週枠(1W)の使用率。CX は Codex のセッションログに残った最後の値を読む。
# 項目名(CTX/TTL/CC/CX)は白。状態で変わる値は 灰(通常)・黄・赤 の3色だけを使う。
# CTX/CC/CX は 70%未満=灰 70-89%=黄 90%以上=赤、TTL は残り30分以下=黄 10分以下=赤。CC/CX は黄/赤の枠にだけリセット時刻を付ける。
# 通常値を灰にして黄/赤だけを目立たせることで、項目が増えても警告箇所が一目でわかるようにする。
# 黄/赤は警告専用なので、モデル名の色(Fable=マゼンタ Opus=シアン Sonnet=青 Haiku=緑)には使わない。
# TTL はプロンプトキャッシュ(サブスク課金では1h固定)の失効予定時刻。transcript の最終送信から1h後を計算する。
# 呼ばれる回数が多いので fork を減らす（入力の jq は1回だけ、時刻の整形は bash の組み込み）。
set -euo pipefail

WHITE='\033[97m'
GRAY='\033[90m'
YELLOW='\033[33m'
RED='\033[31m'
RESET='\033[0m'
# モデル名の色。黄/赤は警告に取っておくので使わない。
MAGENTA='\033[35m'
CYAN='\033[36m'
BLUE='\033[34m'
GREEN='\033[32m'

input="$(cat)"

IFS=$'\x1f' read -r dir model size ctx five_h week five_h_resets week_resets transcript_path effort < <(
  jq -r '[
    (.workspace.current_dir // .cwd // ""),
    (.model.display_name // ""),
    (.context_window.context_window_size // ""),
    (.context_window.used_percentage // ""),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.rate_limits.five_hour.resets_at // ""),
    (.rate_limits.seven_day.resets_at // ""),
    (.transcript_path // ""),
    (.effort.level // "")
  ] | map(tostring) | join("\u001f")' <<<"$input"
)

# 表示用に $HOME 配下を ~ に短縮する (例: $HOME/repos/trial -> ~/repos/trial)。
# git には短縮前のパスを渡す (クォートの中の ~ は展開されない)。
raw_dir="$dir"
if [ -n "${HOME:-}" ] && [ "${dir#"$HOME"}" != "$dir" ]; then
  dir="~${dir#"$HOME"}"
fi

fmt_size() {
  local n="$1"
  [ -z "$n" ] && return
  if [ "$n" -ge 1000000 ]; then
    printf '%sM' "$((n / 1000000))"
  elif [ "$n" -ge 1000 ]; then
    printf '%sK' "$((n / 1000))"
  else
    printf '%s' "$n"
  fi
}

# resets_at (epoch秒) を絶対時刻 "HH:MM" にする。当日でなければ曜日を1文字前置する (例: 木18:23)。
# epoch 秒以外 (ISO-8601 等) が来たら算術エラーを出さずに黙って諦める。
fmt_remaining() {
  local resets_at="$1"
  [ -z "$resets_at" ] && return
  case "$resets_at" in
    ''|*[!0-9]*) return ;;
  esac
  local remaining=$((resets_at - EPOCHSECONDS))
  [ "$remaining" -le 0 ] && return
  local today reset_fields reset_day hm wd
  printf -v today '%(%Y-%m-%d)T' -1
  printf -v reset_fields '%(%Y-%m-%d %H:%M %u)T' "$resets_at"
  read -r reset_day hm wd <<<"$reset_fields"
  if [ "$today" = "$reset_day" ]; then
    printf '%s' "$hm"
  else
    local wdays=(月 火 水 木 金 土 日)
    printf '%s%s' "${wdays[$((wd - 1))]}" "$hm"
  fi
}

pct_color() {
  if [ "$1" -ge 90 ]; then
    printf '%s' "$RED"
  elif [ "$1" -ge 70 ]; then
    printf '%s' "$YELLOW"
  else
    printf '%s' "$GRAY"
  fi
}

colorize() {
  local label="$1" pct_raw="$2"
  [ -z "$pct_raw" ] && return
  local pct
  printf -v pct '%.0f' "$pct_raw"
  printf '%b%s %b%s%%%b' "$WHITE" "$label" "$(pct_color "$pct")" "$pct" "$RESET"
}

# 5時間枠と週枠を "CC 5H 75% (18:23) 1W 36%" の形で出す。引数は ラベル 5H% 5Hリセット 1W% 1Wリセット。
# 枠ごとに色を付け、黄/赤の枠にだけリセット時刻を付ける。
# resets_at を過ぎた枠は古い値なので "5H -" にし、両方とも出せなければ何も出さない。
fmt_limits() {
  local label="$1" out="" shown=0 i name pct reset color
  for i in 2 4; do
    if [ "$i" -eq 2 ]; then name=5H; else name=1W; fi
    pct="${!i}" reset="$(( i + 1 ))"
    reset="${!reset}"
    case "$reset" in
      ''|*[!0-9]*) reset=0 ;;
    esac
    if [ -z "$pct" ] || [ "$reset" -le "$EPOCHSECONDS" ]; then
      out="$out $GRAY$name -"
      continue
    fi
    printf -v pct '%.0f' "$pct"
    color=$(pct_color "$pct")
    out="$out $color$name $pct%"
    [ "$color" != "$GRAY" ] && out="$out ($(fmt_remaining "$reset"))"
    shown=1
  done
  [ "$shown" -eq 0 ] && return 0
  printf '%b%s%b%b' "$WHITE" "$label" "$out" "$RESET"
}

# transcript(JSONL)の最終エントリの timestamp + 1h = プロンプトキャッシュTTL失効予定時刻。
# 1h経過済み(キャッシュが冷えている)場合は何も出さない。
fmt_cache_ttl() {
  local path="$1"
  if [ -z "$path" ] || [ ! -f "$path" ]; then
    return 0
  fi
  # ファイル全体を tac すると長時間セッション(数MB〜十数MB)で重くなるため、
  # 末尾64KBだけを対象にする。それでtimestampが拾えなければ全体にフォールバックする。
  local last_ts
  last_ts=$(tail -c 65536 "$path" 2>/dev/null | tac 2>/dev/null | jq -r 'select(.timestamp != null) | .timestamp' 2>/dev/null | head -1) || true
  if [ -z "$last_ts" ]; then
    last_ts=$(tac "$path" 2>/dev/null | jq -r 'select(.timestamp != null) | .timestamp' 2>/dev/null | head -1) || true
  fi
  if [ -z "$last_ts" ]; then
    return 0
  fi
  local last_epoch
  last_epoch=$(date -d "$last_ts" +%s 2>/dev/null) || true
  if [ -z "$last_epoch" ]; then
    return 0
  fi
  local expiry=$((last_epoch + 3600))
  local remaining=$((expiry - EPOCHSECONDS))
  if [ "$remaining" -le 0 ]; then
    return 0
  fi
  local color="$GRAY"
  if [ "$remaining" -le 600 ]; then
    color="$RED"
  elif [ "$remaining" -le 1800 ]; then
    color="$YELLOW"
  fi
  local expiry_hm
  printf -v expiry_hm '%(%H:%M)T' "$expiry"
  printf '%bTTL %b%s%b' "$WHITE" "$color" "$expiry_hm" "$RESET"
}

# Codex の 5時間枠/週枠。~/.codex/sessions/ の rollout(JSONL) の token_count に残った最後の rate_limits を読む。
# Codex を最後に動かした時点の値なので、枠が古いかどうかは fmt_limits が resets_at で判断する。
fmt_codex() {
  local days=("${CODEX_HOME:-$HOME/.codex}"/sessions/*/*/*/)
  [ -d "${days[-1]}" ] || return 0
  # 日をまたいで続いているセッションもあるので、直近2日の中で最後に書かれたファイルを使う。
  # 要素が1つのとき ${days[@]: -2} は空になるので、始まりの位置を 0 で止める。
  local from=$(( ${#days[@]} > 2 ? ${#days[@]} - 2 : 0 ))
  local f="" d c
  for d in "${days[@]:from}"; do
    for c in "$d"rollout-*.jsonl; do
      [ -f "$c" ] || continue
      if [ -z "$f" ] || [ "$c" -nt "$f" ]; then
        f="$c"
      fi
    done
  done
  [ -n "$f" ] || return 0
  local p_pct="" p_reset="" s_pct="" s_reset=""
  IFS=$'\x1f' read -r p_pct p_reset s_pct s_reset < <(
    grep -F '"rate_limits":{"' "$f" 2>/dev/null | tail -n 1 |
      jq -r '.payload.rate_limits | [.primary.used_percent, .primary.resets_at, .secondary.used_percent, .secondary.resets_at] | map(. // "" | tostring) | join("\u001f")' 2>/dev/null
  ) || true
  fmt_limits CX "$p_pct" "$p_reset" "$s_pct" "$s_reset"
}

size_fmt=$(fmt_size "$size")

# display_name が将来 "(1M context)" 等を自前で付与してきても二重表示にならないよう、
# 既存の末尾括弧書きは一旦剥がしてから size/effort を付け直す。
model="${model%% (*}"
[ -n "$size_fmt" ] && model="$model $size_fmt"
[ -n "$effort" ] && model="$model $effort"

# dir が空だと git が statusline プロセスの cwd を見て無関係なブランチを表示する。
branch=""
[ -n "$raw_dir" ] && branch=$(git -C "$raw_dir" branch --show-current 2>/dev/null || true)

line="$dir"
[ -n "$branch" ] && line="$line ($branch)"
case "$model" in
  *Fable*) mcolor="$MAGENTA" ;;
  *Opus*) mcolor="$CYAN" ;;
  *Sonnet*) mcolor="$BLUE" ;;
  *Haiku*) mcolor="$GREEN" ;;
  *) mcolor="" ;;
esac
printf -v model_fmt '%b%s%b' "$mcolor" "$model" "$RESET"
line="$line $model_fmt"
for part in "$(colorize CTX "$ctx")" "$(fmt_cache_ttl "$transcript_path")" "$(fmt_limits CC "$five_h" "$five_h_resets" "$week" "$week_resets")" "$(fmt_codex)"; do
  [ -n "$part" ] && line="$line │ $part"
done

printf '%s\n' "$line"
