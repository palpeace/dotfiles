#!/usr/bin/env bash
# 環境をまとめて更新する（dotfiles・apt・mise・zsh プラグイン・AI エージェント CLI・herdr の連携）。
# 各段は失敗しても次へ進み、最後に失敗した段を一覧にする。
set -uo pipefail

PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH
export CODEX_NON_INTERACTIVE=1 # codex update が質問を出さないように
mise="$HOME/.local/bin/mise"
failures=()

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
run() { # <段の名前> <コマンド...>
  local name="$1"
  shift
  "$@" || failures+=("$name")
}

# agy の更新はシェルの設定ファイルに PATH の行を書き足しうる（インストーラと同じ処理を持つ）。
# chezmoi の run_onchange_after_10-ai-clis.sh と同じく、前後で退避して戻す。
keep_profiles() {
  local backup f
  backup="$(mktemp -d)"
  for f in .bashrc .profile .zprofile .zshrc; do
    [ -f "$HOME/$f" ] && cp -p "$HOME/$f" "$backup/$f"
  done
  "$@"
  local status=$?
  for f in .bashrc .profile .zprofile .zshrc; do
    if [ -f "$backup/$f" ]; then
      cat "$backup/$f" >"$HOME/$f"
    else
      rm -f "$HOME/$f"
    fi
  done
  rm -rf "$backup"
  return "$status"
}

step "dotfiles"
run "chezmoi update" chezmoi update

step "apt"
export DEBIAN_FRONTEND=noninteractive
apt_opts=(-o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
run "apt" bash -c 'sudo apt-get "$@" update && sudo apt-get "$@" upgrade -y && sudo apt-get "$@" autoremove -y' _ "${apt_opts[@]}"

step "mise"
herdr_before="$(herdr --version 2>/dev/null || true)"
run "mise self-update" "$mise" self-update -y
mise_log="$(mktemp)"
upgrade_mise() { "$mise" upgrade 2>&1 | tee "$mise_log"; }
run "mise upgrade" upgrade_mise
# 新しい版が OS に無い共有ライブラリを要ることがある（node 26 の libatomic.so.1）。
# mise は入れたあとの試し実行に落ちた版を消すので、upgrade の出力と、入っている版の ldd の両方から拾う
missing_libs() { # <mise upgrade の出力のファイル>
  local dir f
  {
    grep -oE 'error while loading shared libraries: [^:]+' "$1" 2>/dev/null | sed 's/.*: //'
    "$mise" ls --current --json 2>/dev/null | jq -r '.[][] | select(.installed) | .install_path' |
      while IFS= read -r dir; do
        find "$dir" -maxdepth 3 -type f -perm -u+x -size +100k 2>/dev/null
      done |
      while IFS= read -r f; do
        [ "$(head -c4 "$f" | tr -d '\0')" = $'\x7fELF' ] || continue
        ldd "$f" 2>/dev/null | awk '/=> not found/ {print $1}'
      done
  } | sort -u
}
libs="$(missing_libs "$mise_log")"
rm -f "$mise_log"
if [ -n "$libs" ]; then
  echo "OS に足りない共有ライブラリがある（apt で入れ、dotfiles の bootstrap.sh の一覧にも足す。libatomic.so.1 なら libatomic1）:"
  printf '  %s\n' $libs
  failures+=("共有ライブラリ")
fi
# mise prune は実行しても消さないことがあるので、消し残りを見せるだけにする
prunable="$("$mise" ls --prunable 2>/dev/null || true)"
if [ -n "$prunable" ]; then
  echo "未使用の版が残っている（消すなら mise uninstall <tool>@<version>）:"
  printf '%s\n' "$prunable"
fi

step "zsh plugins"
run "sheldon" sheldon lock --update

step "AI agent CLIs"
command -v claude >/dev/null 2>&1 && run "claude update" claude update
command -v codex >/dev/null 2>&1 && run "codex update" codex update
command -v agy >/dev/null 2>&1 && run "agy update" keep_profiles agy update

# codex は mise の外で版が変わるので、補完はここで作り直す
comp_dir="$HOME/.local/share/zsh/site-functions"
mkdir -p "$comp_dir"
completion() { "$1" completion zsh >"$comp_dir/_$1"; }
command -v codex >/dev/null 2>&1 && run "codex completion" completion codex
command -v herdr >/dev/null 2>&1 && run "herdr completion" completion herdr
rm -f "$HOME"/.zcompdump*

step "herdr"
# 版が上がると連携（エージェントのフック）の版も上がりうるので、古いものだけ入れ直す
herdr_after="$(herdr --version 2>/dev/null || true)"
if [ -n "$herdr_after" ] && [ "$herdr_before" != "$herdr_after" ]; then
  herdr_status="$(herdr integration status 2>/dev/null || true)"
  for pair in claude:claude codex:codex antigravity-cli:agy; do
    target="${pair%%:*}"
    command -v "${pair#*:}" >/dev/null 2>&1 || continue
    printf '%s\n' "$herdr_status" | grep -q "^$target: current " && continue
    run "herdr integration $target" herdr integration install "$target"
  done
fi
# 動いているサーバは古い版のままだが、新しいクライアントと通信できる間は再起動しなくてよい。
# 通信できなくなったときだけ herdr が restart_needed を立てる
if [ "$(herdr status --json 2>/dev/null | jq -r '.update.restart_needed' 2>/dev/null)" = "true" ]; then
  echo "herdr のサーバを再起動する必要がある（新しい版のクライアントと通信できない）。"
  echo "作業の区切りで herdr server stop を実行し、herdr で入り直す。"
  echo "ペインのプロセスは終わるが、配置は戻り、Claude Code・Codex・agy の会話は再開される。"
fi

if [ ${#failures[@]} -gt 0 ]; then
  echo >&2
  echo "失敗した段: ${failures[*]}（もう一度 update-system を実行すると再試行する）" >&2
  exit 1
fi
echo
echo "すべて更新した。新しい設定は新しいシェルから効く。"
