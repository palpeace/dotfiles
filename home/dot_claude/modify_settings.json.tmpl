#!/bin/sh
# chezmoi が今の ~/.claude/settings.json を標準入力で渡す。
# 宣言したキーだけを上書きし、Claude Code が実行時に書くキー（model、enabledPlugins など）は残す。
#
# 失敗しても apply を止めない。ここで非ゼロ終了すると、chezmoi apply は辞書順で
# 早い .claude/ で中断し、.config/ 以降が配置されないまま終わる。
# jq が動かないときや JSON が壊れているときは、入力をそのまま返して警告だけ出す。
set -eu
PATH="$HOME/.local/share/mise/shims:$PATH"
# 新しいマシンの初回 apply では、辞書順で .claude/ が .config/ より先に処理されるので
# ~/.config/mise/config.toml がまだ無く、jq の shim が版を決められない。ソースの設定を読ませる
export MISE_GLOBAL_CONFIG_FILE={{ joinPath .chezmoi.sourceDir "dot_config/mise/config.toml" | quote }}

input=$(cat)
[ -n "$input" ] || input='{}'

if ! jq -n 1 >/dev/null 2>&1; then
  echo "warning: jq が動かないため ~/.claude/settings.json を更新しなかった（次の chezmoi apply で入る）" >&2
  printf '%s\n' "$input"
  exit 0
fi
if ! printf '%s' "$input" | jq empty >/dev/null 2>&1; then
  echo "warning: ~/.claude/settings.json が JSON として壊れているので、そのまま残した" >&2
  printf '%s\n' "$input"
  exit 0
fi

# terminalProgressBarEnabled: 長い処理の間、Windows Terminal のタブとタスクバーに進捗を出す
# preferredNotifChannel:      入力待ちでベルを鳴らす（WT の bellStyle と組でタスクバーが点滅）
# inputNeededNotifEnabled:    権限確認や質問で止まったらモバイルへ通知する
# disableAgentView:           常駐の agent view を止める（WSL2 で重いため）
# statusLine:                 ~/.local/bin/claude-statusline（dotfiles 管理）で状態を1行に出す
# permissions.deny:           claude.ai の Artifact と Claude Docs を読み書きともに使わない（Codex など
#                             ほかのエージェントから読めないため）。ほかの deny の行には触れない
# skillOverrides:             その道具にしか使わないスキルを一覧から外し、文脈を使わせない
#                             （プラグインから来たスキルには効かない）
#
# block_claude_ai_publish: true なら下の道具を deny に足してスキルを off にし、false なら両方を消す
# （deny は Artifact で始まる行と mcp__claude_ai_Claude_Docs で始まる行、skillOverrides は下の名前を消す）。
block_claude_ai_publish=true
if merged=$(printf '%s' "$input" | jq --argjson block "$block_claude_ai_publish" '["Artifact",
  "ArtifactComments",
  "ArtifactData",
  "mcp__claude_ai_Claude_Docs"] as $publish
  | ["artifact-design", "artifact-diagramming", "artifact-capabilities", "anthropic-skills:docs"] as $skills
  | (. * {
  autoMemoryEnabled: false,
  cleanupPeriodDays: 365,
  theme: "dark",
  tui: "fullscreen",
  skipDangerousModePermissionPrompt: true,
  terminalProgressBarEnabled: true,
  preferredNotifChannel: "terminal_bell",
  inputNeededNotifEnabled: true,
  disableAgentView: true,
  statusLine: { type: "command", command: "$HOME/.local/bin/claude-statusline" }
}) | .permissions.deny = ((.permissions.deny // []) | map(select((startswith("Artifact") or startswith("mcp__claude_ai_Claude_Docs")) | not)) + (if $block then $publish else [] end) | unique)
  | if .permissions.deny == [] then del(.permissions.deny) else . end
  | if .permissions == {} then del(.permissions) else . end
  | .skillOverrides = ((.skillOverrides // {}) | with_entries(select(.key as $k | $skills | index($k) | not))
      + (if $block then ($skills | map({key: ., value: "off"}) | from_entries) else {} end))
  | if .skillOverrides == {} then del(.skillOverrides) else . end' 2>/dev/null) && [ -n "$merged" ]; then
  printf '%s\n' "$merged"
else
  echo "warning: ~/.claude/settings.json のマージに失敗したので、そのまま残した" >&2
  printf '%s\n' "$input"
fi
