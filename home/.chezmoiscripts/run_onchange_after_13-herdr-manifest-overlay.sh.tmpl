#!/bin/sh
# herdr の判定表に手元の規則を足した上書きを作り、herdr が新しい表を取ってくるたびに作り直す
# systemd の path ユニットを有効にする（中身は herdr-manifest-overlay と ~/.config/herdr/agent-overlays/）。
# スクリプトかユニットか足す規則が変わった時に再実行する:
# script hash: {{ include "dot_local/bin/executable_herdr-manifest-overlay" | sha256sum }}
# path hash: {{ include "dot_config/systemd/user/herdr-manifest-overlay.path" | sha256sum }}
# service hash: {{ include "dot_config/systemd/user/herdr-manifest-overlay.service" | sha256sum }}
# claude overlay hash: {{ include "dot_config/herdr/agent-overlays/claude.toml" | sha256sum }}
set -eu
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
command -v herdr >/dev/null 2>&1 || exit 0

"$HOME/.local/bin/herdr-manifest-overlay"

if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now herdr-manifest-overlay.path
else
  echo "warning: systemd のユーザーのインスタンスが無いので、herdr の判定表の上書きは chezmoi apply のときしか作り直されない" >&2
fi
