#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(chezmoi source-path)/.."
target_settings_file="${repo_dir}/assets/orca/settings.json"
target_keymap_file="${repo_dir}/assets/orca/keymap.json"

windows_user="${WINDOWS_USER:-$USER}"
win_profile=""
if [ -x "/mnt/c/Windows/System32/cmd.exe" ]; then
    win_profile="$(/mnt/c/Windows/System32/cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r' || true)"
elif command -v cmd.exe >/dev/null 2>&1; then
    win_profile="$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r' || true)"
fi

if [ -n "$win_profile" ] && command -v wslpath >/dev/null 2>&1; then
    if [[ "$win_profile" =~ "systemprofile" ]]; then
        echo "⚠️  Detected SYSTEM profile ($win_profile). Falling back to explicit WINDOWS_USER." >&2
        windows_home="/mnt/c/Users/${windows_user}"
    else
        windows_home="$(wslpath "$win_profile")"
    fi
else
    windows_home="/mnt/c/Users/${windows_user}"
fi

source_dir="${windows_home}/AppData/Roaming/Orca"

if [ ! -d "$source_dir" ]; then
    echo "Orca config directory not found: $source_dir" >&2
    exit 1
fi

mkdir -p "${repo_dir}/assets/orca"

if [ -f "${source_dir}/settings.json" ]; then
    cp "${source_dir}/settings.json" "$target_settings_file"
    echo "Pulled Orca settings to $target_settings_file"
fi

if [ -f "${source_dir}/keymap.json" ]; then
    cp "${source_dir}/keymap.json" "$target_keymap_file"
    echo "Pulled Orca keymap to $target_keymap_file"
fi
