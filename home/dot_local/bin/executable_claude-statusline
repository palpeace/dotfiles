#!/usr/bin/env bash
# Claude Code statusLine。~/.claude/settings.json の statusLine.command から呼ばれる。
# 表示例: ~/repos/trial (main) Opus 5 (1M context) CTX 1% 5H 1% (2h30m) 1W 36% (3d4h) TTL 17:23(42m)
# CTX/5H/1W は 70%未満=緑 70-89%=黄 90%以上=赤 で警告表示する。
# TTL はプロンプトキャッシュ(サブスク課金では1h固定)の失効予定時刻。transcript の最終送信から1h後を計算する。
set -euo pipefail

GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
BLUE='\033[34m'
MAGENTA='\033[35m'
RESET='\033[0m'

input="$(cat)"

dir=$(jq -r '.workspace.current_dir // .cwd // empty' <<<"$input")
model=$(jq -r '.model.display_name // empty' <<<"$input")
size=$(jq -r '.context_window.context_window_size // empty' <<<"$input")
ctx=$(jq -r '.context_window.used_percentage // empty' <<<"$input")
five_h=$(jq -r '.rate_limits.five_hour.used_percentage // empty' <<<"$input")
week=$(jq -r '.rate_limits.seven_day.used_percentage // empty' <<<"$input")
five_h_resets=$(jq -r '.rate_limits.five_hour.resets_at // empty' <<<"$input")
week_resets=$(jq -r '.rate_limits.seven_day.resets_at // empty' <<<"$input")
transcript_path=$(jq -r '.transcript_path // empty' <<<"$input")

fmt_size() {
  local n="$1"
  [ -z "$n" ] && return
  if [ "$n" -ge 1000000 ]; then
    printf '%sM' "$((n / 1000000))"
  elif [ "$n" -ge 1000 ]; then
    printf '%sK' "$((n / 1000))"
  else
    printf '%s' "$n"
  fi
}

# resets_at (epoch秒) までの残り時間を "Xh Ym" / "Xd Yh" 形式にする。
# epoch 秒以外 (ISO-8601 等) が来たら算術エラーを出さずに黙って諦める。
fmt_remaining() {
  local resets_at="$1"
  [ -z "$resets_at" ] && return
  case "$resets_at" in
    ''|*[!0-9]*) return ;;
  esac
  local now remaining
  now=$(date +%s)
  remaining=$((resets_at - now))
  [ "$remaining" -le 0 ] && return
  local days=$((remaining / 86400))
  local hours=$(((remaining % 86400) / 3600))
  local mins=$(((remaining % 3600) / 60))
  if [ "$days" -ge 1 ]; then
    printf '%dd%dh' "$days" "$hours"
  else
    printf '%dh%dm' "$hours" "$mins"
  fi
}

# 閾値に応じて "ラベル 値%(残り時間)" を色付けする。
colorize() {
  local label="$1" pct_raw="$2" resets_at="${3:-}"
  [ -z "$pct_raw" ] && return
  local pct
  pct=$(printf '%.0f' "$pct_raw")
  local color="$GREEN"
  if [ "$pct" -ge 90 ]; then
    color="$RED"
  elif [ "$pct" -ge 70 ]; then
    color="$YELLOW"
  fi
  local remaining
  remaining=$(fmt_remaining "$resets_at")
  if [ -n "$remaining" ]; then
    printf '%b%s %s%% (%s)%b' "$color" "$label" "$pct" "$remaining" "$RESET"
  else
    printf '%b%s %s%%%b' "$color" "$label" "$pct" "$RESET"
  fi
}

# transcript(JSONL)の最終エントリの timestamp + 1h = プロンプトキャッシュTTL失効予定時刻。
# 1h経過済み(キャッシュが冷えている)場合は何も出さない。
fmt_cache_ttl() {
  local path="$1"
  if [ -z "$path" ] || [ ! -f "$path" ]; then
    return 0
  fi
  local last_ts
  last_ts=$(tac "$path" 2>/dev/null | jq -r 'select(.timestamp != null) | .timestamp' 2>/dev/null | head -1) || true
  if [ -z "$last_ts" ]; then
    return 0
  fi
  local last_epoch
  last_epoch=$(date -d "$last_ts" +%s 2>/dev/null) || true
  if [ -z "$last_epoch" ]; then
    return 0
  fi
  local now expiry remaining
  now=$(date +%s)
  expiry=$((last_epoch + 3600))
  remaining=$((expiry - now))
  if [ "$remaining" -le 0 ]; then
    return 0
  fi
  local color="$GREEN"
  if [ "$remaining" -le 600 ]; then
    color="$RED"
  elif [ "$remaining" -le 1800 ]; then
    color="$YELLOW"
  fi
  local expiry_hm mins
  expiry_hm=$(date -d "@$expiry" +%H:%M)
  mins=$((remaining / 60))
  printf '%bTTL %s(%dm)%b' "$color" "$expiry_hm" "$mins" "$RESET"
}

# モデル名に応じて色を変える。Opus系=赤、Sonnet系=青、それ以外=マゼンタ
model_color() {
  local name="$1"
  case "$name" in
    *Opus*) printf '%s' "$RED" ;;
    *Sonnet*) printf '%s' "$BLUE" ;;
    *) printf '%s' "$MAGENTA" ;;
  esac
}

size_fmt=$(fmt_size "$size")
[ -n "$size_fmt" ] && model="$model ($size_fmt context)"

mcolor=$(model_color "$model")
model_fmt=$(printf '%b%s%b' "$mcolor" "$model" "$RESET")

# dir が空だと git が statusline プロセスの cwd を見て無関係なブランチを表示する。
branch=""
[ -n "$dir" ] && branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)

line="$dir"
[ -n "$branch" ] && line="$line ($branch)"
line="$line $model_fmt"
for part in "$(colorize CTX "$ctx")" "$(colorize 5H "$five_h" "$five_h_resets")" "$(colorize 1W "$week" "$week_resets")" "$(fmt_cache_ttl "$transcript_path")"; do
  [ -n "$part" ] && line="$line $part"
done

printf '%s\n' "$line"
